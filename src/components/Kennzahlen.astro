---
// Zeigt nur Kennzahlen mit einem Wert ab 3. Gibt es keine, wird der ganze Block ausgeblendet.
import { sichtbareKennzahlen, type KennzahlSchluessel } from '../lib/kennzahlen';
interface Props { schluessel: KennzahlSchluessel[]; titel?: string; }
const { schluessel, titel } = Astro.props;
const liste = sichtbareKennzahlen(schluessel);
---
{liste.length > 0 && (
  <section class="abschnitt" aria-label={titel ?? 'Aktuelle Zahlen'}>
    <div class="wrap">
      {titel && <h2>{titel}</h2>}
      <ul class="raster kennzahlen">
        {liste.map((k) => (
          <li class="karte"><strong>{k.wert.toLocaleString('de-DE')}</strong> {k.text}</li>
        ))}
      </ul>
      <p class="unter-hinweis">Stand: {new Date(liste[0].stand).toLocaleDateString('de-DE')}</p>
    </div>
  </section>
)}
<style>
.kennzahlen strong { display: block; font-size: clamp(2.5rem, 6vw, 3.5rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1.05; color: var(--text); font-variant-numeric: tabular-nums; }
  .kennzahlen li { color: var(--text); }
</style>
