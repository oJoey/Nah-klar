---
import { site } from '../config/site';
import { seiten, istLive, link, type SeitenSchluessel } from '../config/seiten';
const navPunkte: SeitenSchluessel[] = ['mieten', 'vermieten', 'werkzeuge', 'regionen', 'hilfe'];
const sichtbar = navPunkte.filter(istLive);
const aktuell = Astro.url.pathname;
const aktiv = (k: SeitenSchluessel) => aktuell.startsWith(seiten[k].pfad);
---
<header class="kopf">
  <div class="wrap kopf-innen">
    <a href="/" class="marke">{site.name}</a>
    <nav class="nav-gross" aria-label="Hauptnavigation">
      <ul>
        {sichtbar.map((k) => <li><a href={seiten[k].pfad} aria-current={aktiv(k) ? 'page' : undefined}>{seiten[k].titel}</a></li>)}
      </ul>
    </nav>
    <div class="kopf-cta">
      <a class="btn btn-primaer" href={link('platzAnbieten')}>Platz anbieten</a>
      <span class="kopf-kostenlos">Für Vermieter immer kostenlos</span>
    </div>
    <details class="nav-klein">
      <summary>Menü</summary>
      <nav aria-label="Hauptnavigation mobil">
        <ul>
          <li class="nav-klein-cta">
            <a class="btn btn-primaer btn-voll" href={link('platzAnbieten')}>Platz anbieten</a>
            <span class="kostenlos">Für Vermieter immer kostenlos</span>
          </li>
          {sichtbar.map((k) => <li><a href={seiten[k].pfad} aria-current={aktiv(k) ? 'page' : undefined}>{seiten[k].titel}</a></li>)}
          <li><a href={link('suchauftrag')}>Platz finden</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  .kopf { border-bottom: 1px solid var(--rand); background: #fff; position: relative; z-index: 10; }
  .kopf-innen { display: flex; align-items: center; gap: 0.75rem; padding-block: 0.6rem; }
  .marke { font-weight: 800; font-size: 1.3rem; color: var(--blau-900); text-decoration: none; margin-right: auto; padding-block: 0.6rem; }
  .nav-gross { display: none; }
  .nav-gross ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-gross a, .nav-klein a:not(.btn) {
    display: flex; align-items: center; min-height: 3rem; padding-inline: 0.75rem;
    color: var(--blau-900); text-decoration: none; font-weight: 600; border-radius: 8px;
  }
  .nav-gross a:hover, .nav-klein a:not(.btn):hover { background: var(--blau-50); }
  [aria-current='page'] { text-decoration: underline !important; text-decoration-thickness: 3px !important; text-underline-offset: 0.4em; }
  .kopf-cta { display: flex; flex-direction: column; align-items: center; }
  .kopf-cta .btn { min-height: 3rem; padding-inline: 0.9rem; white-space: nowrap; }
  .kopf-kostenlos { font-size: 0.875rem; font-weight: 700; color: var(--akzent-text); line-height: 1.25; margin-top: 0.2rem; text-align: center; max-width: 9.5rem; }
  .nav-klein > summary {
    list-style: none; display: flex; align-items: center; min-height: 3rem; padding-inline: 0.75rem;
    border: 2px solid var(--rand-feld); border-radius: 8px; font-weight: 700; cursor: pointer;
  }
  .nav-klein > summary::-webkit-details-marker { display: none; }
  .nav-klein > nav { position: absolute; left: 0; right: 0; top: 100%; background: #fff; border-bottom: 1px solid var(--rand); box-shadow: var(--schatten); }
  .nav-klein ul { list-style: none; margin: 0; padding: 0.75rem var(--rand-seite) 1rem; }
  .nav-klein-cta { padding-bottom: 0.75rem; margin-bottom: 0.5rem; border-bottom: 1px solid var(--rand); }
  .nav-klein-cta .kostenlos { display: block; text-align: center; margin-top: 0.35rem; font-size: 1rem; }
  @media (max-width: 22rem) { .kopf-cta .btn { padding-inline: 0.6rem; font-size: 1rem; } }
  @media (min-width: 56rem) {
    .marke { margin-right: 1rem; }
    .nav-gross { display: block; margin-right: auto; }
    .nav-klein { display: none; }
    .kopf-kostenlos { max-width: none; }
  }
</style>
