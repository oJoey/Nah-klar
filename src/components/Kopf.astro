---
import { site } from '../config/site';
import Logo from './Logo.astro';
import { seiten, istLive, link, type SeitenSchluessel } from '../config/seiten';
const navPunkte: SeitenSchluessel[] = ['mieten', 'vermieten', 'werkzeuge', 'regionen', 'hilfe'];
const sichtbar = navPunkte.filter(istLive);
const aktuell = Astro.url.pathname;
const aktiv = (k: SeitenSchluessel) => aktuell.startsWith(seiten[k].pfad);
---
<header class="kopf">
  <div class="wrap kopf-innen">
    <a href="/" class="marke"><Logo /> <span>{site.name}</span></a>
    <nav class="nav-gross" aria-label="Hauptnavigation">
      <ul>
        {sichtbar.map((k) => <li><a href={seiten[k].pfad} aria-current={aktiv(k) ? 'page' : undefined}>{seiten[k].titel}</a></li>)}
      </ul>
    </nav>
    <div class="kopf-cta">
      <a class="btn btn-primaer" href={link('platzAnbieten')}>Platz anbieten</a>
      <span class="kopf-kostenlos">Für Vermieter immer kostenlos</span>
    </div>
    <details class="nav-klein">
      <summary aria-label="Menü">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </summary>
      <nav aria-label="Hauptnavigation mobil">
        <ul>
          <li class="nav-klein-cta">
            <a class="btn btn-primaer btn-gross btn-voll" href={link('platzAnbieten')}>Platz anbieten</a>
            <span class="kostenlos">Für Vermieter immer kostenlos</span>
          </li>
          {sichtbar.map((k) => <li><a class="nav-link" href={seiten[k].pfad} aria-current={aktiv(k) ? 'page' : undefined}>{seiten[k].titel}</a></li>)}
          <li><a class="nav-link" href={link('suchauftrag')}>Platz finden</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  /* Durchscheinende Leiste: Inhalt scrollt darunter durch */
  .kopf {
    position: sticky; top: 0; z-index: 20;
    background: rgb(251 249 245 / 0.82);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--linie);
  }
  .kopf-innen { display: flex; align-items: center; gap: 0.5rem; min-height: var(--kopf-hoehe); padding-block: 0.5rem; }
  .marke { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; color: var(--marine); text-decoration: none; margin-right: auto; padding-block: 0.5rem; white-space: nowrap; }
  .marke :global(svg) { flex: none; }
  /* Sehr schmale Handys: nur das Zeichen, Name bleibt für Screenreader lesbar */
  @media (max-width: 24.5rem) {
    .marke span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .kopf-cta .btn { padding-inline: 1rem; font-size: 1rem; }
  }
  .nav-gross { display: none; }
  .nav-gross ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-gross a {
    display: flex; align-items: center; min-height: 3rem; padding-inline: 0.9rem;
    color: var(--text); text-decoration: none; font-size: 1.05rem; border-radius: 999px;
    transition: background-color 150ms ease;
  }
  .nav-gross a:hover { background: var(--flaeche-2); color: var(--blau); }
  .nav-gross a[aria-current='page'] { font-weight: 600; background: var(--flaeche-2); }
  /* Hinweis unter dem Button, ohne die Leiste zu verbreitern */
  .kopf-cta { position: relative; display: flex; flex-direction: column; align-items: center; padding-bottom: 1.15rem; }
  .kopf-cta .btn { min-height: 2.75rem; padding: 0.45rem 1.1rem; font-size: 1.05rem; white-space: nowrap; }
  .kopf-kostenlos { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); font-size: 0.8125rem; font-weight: 600; color: var(--akzent-text); line-height: 1.2; white-space: nowrap; }

  .nav-klein > summary {
    list-style: none; display: grid; place-items: center; width: 3rem; height: 3rem;
    border-radius: 999px; cursor: pointer; color: var(--text);
  }
  .nav-klein > summary:hover { background: var(--flaeche-2); }
  .nav-klein > summary::-webkit-details-marker { display: none; }
  .nav-klein[open] > summary { background: var(--flaeche-2); }
  .nav-klein > nav {
    position: absolute; left: 0; right: 0; top: 100%;
    background: rgb(251 249 245 / 0.98);
    backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgb(0 0 0 / 0.08); box-shadow: 0 24px 40px rgb(0 0 0 / 0.08);
  }
  .nav-klein ul { list-style: none; margin: 0; padding: 1rem var(--rand-seite) 1.5rem; }
  .nav-klein-cta { padding-bottom: 1.25rem; margin-bottom: 0.5rem; text-align: center; }
  .nav-klein-cta .kostenlos { display: block; margin-top: 0.5rem; font-size: 1rem; }
  .nav-link {
    display: flex; align-items: center; min-height: 3.5rem; border-bottom: 1px solid var(--linie);
    color: var(--text); text-decoration: none; font-size: 1.4rem; font-weight: 600; letter-spacing: -0.015em;
  }
  .nav-link[aria-current='page'] { color: var(--blau); }

  @media (min-width: 56rem) {
    .marke { margin-right: 1.5rem; }
    .nav-gross { display: block; margin-right: auto; }
    .nav-klein { display: none; }
    .kopf-cta { flex-direction: row-reverse; gap: 0.9rem; padding-bottom: 0; }
    .kopf-kostenlos { position: static; transform: none; font-size: 0.9375rem; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .kopf, .nav-klein > nav { background: var(--flaeche); backdrop-filter: none; -webkit-backdrop-filter: none; }
  }
</style>
