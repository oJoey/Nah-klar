---
import { getCollection } from 'astro:content';
import { absaetze, klartext, jsonLd } from '../lib/texte';
interface Props { seite: 'start' | 'mieten' | 'vermieten'; titel?: string; }
const { seite, titel = 'Häufige Fragen' } = Astro.props;
const eintraege = (await getCollection('faq', (e) => e.data.seiten.includes(seite)))
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: eintraege.map((e) => ({
    '@type': 'Question',
    name: e.data.frage,
    acceptedAnswer: { '@type': 'Answer', text: klartext(e.body ?? '') },
  })),
};
---
<div class="faq-raster">
<div class="faq-kopf"><h2>{titel}</h2><slot /></div>
<div class="faq klapp-liste">
  {eintraege.map((e) => (
    <details class="klapp">
      <summary>{e.data.frage}</summary>
      <div class="klapp-inhalt" set:html={absaetze(e.body ?? '')} />
    </details>
  ))}
</div>
</div>
<script type="application/ld+json" set:html={jsonLd(schema)} />
<style>
  .faq-raster { display: grid; gap: 1.5rem; }
  @media (min-width: 56rem) { .faq-raster { grid-template-columns: 1fr 1.6fr; gap: 4rem; align-items: start; } }
  .faq-kopf :global(p) { color: var(--text); }
</style>
