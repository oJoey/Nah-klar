---
import o from '../data/optionen.json';
import { link } from '../config/seiten';
// arten: Auswahl einschränken (Startseite: 4 Arten). mitZeitraum: Feld „Ab wann“ zeigen.
interface Props { titel?: string; arten?: { wert: string; titel: string }[]; mitZeitraum?: boolean }
const { titel = 'Was suchen Sie?', arten = o.mieter_art, mitZeitraum = true } = Astro.props;
---
<form class="suchmaske formular-karte" method="get" action={link('suchauftrag')}>
  {titel && <h2 class="suchmaske-titel">{titel}</h2>}
  <div class:list={['suchmaske-felder', { ohne: !mitZeitraum }]}>
    <div class="feld">
      <label for="such-ort">PLZ oder Ort</label>
      <input id="such-ort" name="ort" type="text" autocomplete="postal-code" placeholder="z. B. 71032 oder Böblingen" />
    </div>
    <div class="feld">
      <label for="such-art">Art</label>
      <select id="such-art" name="mieter_art">
        {arten.map((a) => <option value={a.wert}>{a.titel}</option>)}
      </select>
    </div>
    {mitZeitraum && (
      <div class="feld">
        <label for="such-zeitraum">Ab wann</label>
        <select id="such-zeitraum" name="ab_wann">
          {o.ab_wann.map((z) => <option value={z.wert}>{z.titel}</option>)}
        </select>
      </div>
    )}
    <div class="feld suchmaske-knopf">
      <button class="btn btn-primaer btn-voll" type="submit">Platz finden</button>
    </div>
  </div>
  <p class="unter-hinweis">Weiter zum Suchauftrag. Der Suchauftrag ist kostenlos und unverbindlich.</p>
</form>
<style>
.suchmaske-titel { font-size: 1.4rem; letter-spacing: -0.015em; }
  .suchmaske-felder { display: grid; gap: 0 1rem; }
  .suchmaske .feld { margin-bottom: 1rem; }
  .suchmaske .unter-hinweis { margin-top: 0; }
  @media (min-width: 56rem) {
    .suchmaske-felder { grid-template-columns: 1.3fr 1fr 1fr auto; align-items: end; }
    .suchmaske-felder.ohne { grid-template-columns: 1.3fr 1.2fr auto; }
    .suchmaske-knopf .btn { min-height: 3.25rem; }
  }
</style>
