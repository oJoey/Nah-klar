---
import { site, telefonHref, whatsappLink } from '../config/site';
import Logo from './Logo.astro';
import { seiten, istLive, type SeitenSchluessel } from '../config/seiten';
const fussLinks: SeitenSchluessel[] = ['soFunktionierts', 'sicherheit', 'preise', 'ueberUns', 'kontakt', 'impressum', 'datenschutz', 'agb'];
const ratgeberLinks: SeitenSchluessel[] = ['werkzeuge', 'verdienstrechner', 'einwinterung', 'strassenCheck', 'winterplatzVergleich', 'regionen'];
---
<footer class="fuss">
  <div class="wrap">
    <div class="fuss-raster">
      <div>
        <p class="fuss-marke"><Logo hell /> {site.name}</p>
        <p>Nachbarn helfen sich: Privatleute {site.regionIn} vermieten ungenutzten Platz gegen einen fairen Nebenverdienst. Für Vermieter immer kostenlos.</p>
      </div>
      <div>
        <h2 class="fuss-titel">Kontakt</h2>
        <p>{site.ansprechpartner}</p>
        <ul class="fuss-liste">
          <li><a href={telefonHref}>Telefon: {site.telefonAnzeige}</a></li>
          <li><a href={whatsappLink} rel="noopener">WhatsApp: {site.telefonAnzeige}</a></li>
        </ul>
      </div>
      <nav aria-label="Ratgeber und Werkzeuge">
        <h2 class="fuss-titel">Ratgeber & Werkzeuge</h2>
        <ul class="fuss-liste">
          {ratgeberLinks.filter(istLive).map((k) => <li><a href={seiten[k].pfad}>{seiten[k].titel}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Weitere Seiten">
        <h2 class="fuss-titel">Informationen</h2>
        <ul class="fuss-liste">
          {fussLinks.filter(istLive).map((k) => <li><a href={seiten[k].pfad}>{seiten[k].titel}</a></li>)}
        </ul>
      </nav>
    </div>
    <p class="fuss-zeile">© {new Date().getFullYear()} {site.name} · {site.bundesland} · <a href="/impressum/#bildnachweise">Bildnachweise</a></p>
  </div>
</footer>
<style>
  .fuss { background: var(--marine); color: var(--marine-text); padding-top: 3.5rem; font-size: 1rem; }
  .fuss a { color: var(--marine-text); text-decoration: none; display: inline-flex; align-items: center; min-height: 2.75rem; }
  .fuss a:hover { color: #fff; text-decoration: underline; }
  .fuss-raster { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .fuss-marke { display: flex; align-items: center; gap: 0.55rem; font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; color: #fff; margin-bottom: 0.75rem; }
  .fuss-titel { font-size: 1rem; font-weight: 600; letter-spacing: 0; color: #fff; margin-bottom: 0.5rem; }
  .fuss-liste { list-style: none; padding: 0; margin: 0; }
  .fuss-zeile { border-top: 1px solid rgb(255 255 255 / 0.14); padding-block: 1.25rem; margin: 2rem 0 0; }
</style>
