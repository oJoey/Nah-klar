---
import { site, telefonHref, whatsappLink } from '../config/site';
import { seiten, istLive, type SeitenSchluessel } from '../config/seiten';
const fussLinks: SeitenSchluessel[] = ['soFunktionierts', 'sicherheit', 'preise', 'ueberUns', 'kontakt', 'impressum', 'datenschutz', 'agb'];
---
<footer class="fuss">
  <div class="wrap fuss-raster">
    <div>
      <p class="fuss-marke">{site.name}</p>
      <p>Nachbarn helfen sich: Privatleute im {site.region} vermieten ungenutzten Platz gegen einen fairen Nebenverdienst. Für Vermieter immer kostenlos.</p>
    </div>
    <div>
      <h2 class="fuss-titel">Kontakt</h2>
      <p>{site.ansprechpartner}</p>
      <ul class="fuss-liste">
        <li><a href={telefonHref}>Telefon: {site.telefonAnzeige}</a></li>
        <li><a href={whatsappLink} rel="noopener">WhatsApp: {site.telefonAnzeige}</a></li>
      </ul>
    </div>
    <nav aria-label="Weitere Seiten">
      <h2 class="fuss-titel">Informationen</h2>
      <ul class="fuss-liste">
        {fussLinks.filter(istLive).map((k) => <li><a href={seiten[k].pfad}>{seiten[k].titel}</a></li>)}
      </ul>
    </nav>
  </div>
  <p class="wrap fuss-zeile">© {new Date().getFullYear()} {site.name} · {site.region}, {site.bundesland}</p>
</footer>
<style>
  .fuss { background: var(--blau-900); color: #fff; padding-top: 2.5rem; margin-top: 0; }
  .fuss a { color: #fff; display: inline-flex; align-items: center; min-height: 2.75rem; }
  .fuss a:hover { color: var(--akzent-hell); }
  .fuss-raster { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .fuss-marke { font-weight: 800; font-size: 1.3rem; margin-bottom: 0.5rem; }
  .fuss-titel { color: #fff; font-size: 1.1rem; margin-bottom: 0.5rem; }
  .fuss-liste { list-style: none; padding: 0; margin: 0; }
  .fuss-zeile { border-top: 1px solid rgb(255 255 255 / 0.25); padding-block: 1.25rem; margin: 1.5rem auto 0; font-size: 1rem; }
</style>
