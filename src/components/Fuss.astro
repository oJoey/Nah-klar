---
import { site, telefonHref, whatsappLink } from '../config/site';
import { seiten, istLive, type SeitenSchluessel } from '../config/seiten';
const fussLinks: SeitenSchluessel[] = ['soFunktionierts', 'sicherheit', 'preise', 'ueberUns', 'kontakt', 'impressum', 'datenschutz', 'agb'];
---
<footer class="fuss">
  <div class="wrap">
    <div class="fuss-raster">
      <div>
        <p class="fuss-marke">{site.name}</p>
        <p>Nachbarn helfen sich: Privatleute im {site.region} vermieten ungenutzten Platz gegen einen fairen Nebenverdienst. Für Vermieter immer kostenlos.</p>
      </div>
      <div>
        <h2 class="fuss-titel">Kontakt</h2>
        <p>{site.ansprechpartner}</p>
        <ul class="fuss-liste">
          <li><a href={telefonHref}>Telefon: {site.telefonAnzeige}</a></li>
          <li><a href={whatsappLink} rel="noopener">WhatsApp: {site.telefonAnzeige}</a></li>
        </ul>
      </div>
      <nav aria-label="Weitere Seiten">
        <h2 class="fuss-titel">Informationen</h2>
        <ul class="fuss-liste">
          {fussLinks.filter(istLive).map((k) => <li><a href={seiten[k].pfad}>{seiten[k].titel}</a></li>)}
        </ul>
      </nav>
    </div>
    <p class="fuss-zeile">© {new Date().getFullYear()} {site.name} · {site.region}, {site.bundesland}</p>
  </div>
</footer>
<style>
  .fuss { background: var(--flaeche-2); color: var(--text-2); padding-top: 3rem; font-size: 1rem; border-top: 1px solid var(--linie); }
  .fuss a { color: var(--text-2); text-decoration: none; display: inline-flex; align-items: center; min-height: 2.75rem; }
  .fuss a:hover { color: var(--text); text-decoration: underline; }
  .fuss-raster { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .fuss-marke { font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; color: var(--text); margin-bottom: 0.5rem; }
  .fuss-titel { font-size: 1rem; font-weight: 600; letter-spacing: 0; color: var(--text); margin-bottom: 0.5rem; }
  .fuss-liste { list-style: none; padding: 0; margin: 0; }
  .fuss-zeile { border-top: 1px solid var(--linie); padding-block: 1.25rem; margin: 2rem 0 0; }
</style>
