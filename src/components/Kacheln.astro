---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
export type Kachel = { titel: string; text: string; icon: IconName; href: string | null; linkText: string };
interface Props { kacheln: Kachel[]; }
---
<ul class="raster kacheln">
  {Astro.props.kacheln.map((k) => (
    <li class="karte kachel">
      <Icon name={k.icon} />
      <h3>{k.href ? <a href={k.href}>{k.titel}</a> : k.titel}</h3>
      <p>{k.text}</p>
      {k.href && <span class="kachel-link" aria-hidden="true">{k.linkText} →</span>}
    </li>
  ))}
</ul>
<style>
  .kacheln { list-style: none; padding: 0; margin: 0; }
  .kachel { position: relative; display: flex; flex-direction: column; gap: 0.4rem; }
  .kachel h3 a { color: var(--blau-900); text-decoration: none; }
  /* Ganze Karte klickbar, Link bleibt für Screenreader eindeutig */
  .kachel h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .kachel:hover { border-color: var(--primaer); }
  .kachel:has(a:focus-visible) { outline: 3px solid var(--fokus); outline-offset: 2px; }
  .kachel h3 a:focus-visible { outline: none; }
  .kachel-link { margin-top: auto; font-weight: 700; color: var(--primaer); }
</style>
