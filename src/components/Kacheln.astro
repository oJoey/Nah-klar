---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
export type Kachel = { titel: string; text: string; icon: IconName; href: string | null; linkText: string };
interface Props { kacheln: Kachel[]; }
---
<ul class="raster kacheln">
  {Astro.props.kacheln.map((k) => (
    <li class="karte kachel">
      <span class="symbol-flaeche"><Icon name={k.icon} /></span>
      <h3>{k.href ? <a href={k.href}>{k.titel}</a> : k.titel}</h3>
      <p>{k.text}</p>
      {k.href && <span class="kachel-link" aria-hidden="true">{k.linkText}</span>}
    </li>
  ))}
</ul>
<style>
  .kachel { position: relative; display: flex; flex-direction: column; transition: transform 200ms ease, box-shadow 200ms ease; }
  .kachel h3 a { color: inherit; text-decoration: none; }
  /* Ganze Fläche klickbar, der Link bleibt für Screenreader eindeutig */
  .kachel h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--r-gross); }
  .kachel:has(a):hover { transform: translateY(-2px); box-shadow: 0 14px 36px rgb(19 33 58 / 0.12); border-color: transparent; }
  .kachel:has(a):active { transform: scale(0.98); transition-duration: 100ms; }
  .kachel:has(a:focus-visible) { outline: 3px solid var(--fokus); outline-offset: 3px; }
  .kachel h3 a:focus-visible { outline: none; }
  .kachel-link { margin-top: auto; padding-top: 1rem; font-weight: 600; color: var(--blau); }
  .kachel-link::after { content: ' ›'; }
  @media (prefers-reduced-motion: reduce) { .kachel:has(a):hover, .kachel:has(a):active { transform: none; } }
</style>
