---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { bild } from '../lib/bilder';
import type { IconName } from '../lib/icons';
export type Kachel = { titel: string; text: string; icon: IconName; href: string | null; linkText: string; bild?: string };
// ohneFoto: Icon-Illustration statt Foto (auch, solange kein Foto vorliegt). Bildnachweise stehen gesammelt im Impressum, nicht am Bild.
interface Props { kacheln: Kachel[]; kompakt?: boolean; ohneFoto?: boolean; }
const { kacheln, kompakt = false, ohneFoto = false } = Astro.props;
---
<ul class:list={['raster kacheln', { kompakt }]}>
  {kacheln.map((k) => (
    <li class="karte kachel">
      {(() => {
        const b = ohneFoto ? null : bild(k.bild);
        return (
          <div class:list={['kachel-medien', { illu: !b }]}>
            {b ? <Image src={b.src} alt="" width={640} quality={72} widths={[360, 640]} sizes="(min-width: 60rem) 25vw, 100vw" /> : <Icon name={k.icon} />}
            {b && <span class="kachel-symbol"><Icon name={k.icon} /></span>}
          </div>
        );
      })()}
      <h3>{k.href ? <a href={k.href}>{k.titel}</a> : k.titel}</h3>
      <p>{k.text}</p>
      {k.href && <span class="kachel-link" aria-hidden="true">{k.linkText}</span>}
    </li>
  ))}
</ul>
<style>
  .kacheln { grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }
  .kachel { position: relative; display: flex; flex-direction: column; overflow: hidden; padding-top: 0; border: 1.5px solid var(--ueberschrift); box-shadow: 4px 4px 0 var(--ueberschrift); transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out); }
  .kachel h3 a { color: inherit; text-decoration: none; }
  /* Ganze Fläche klickbar, der Link bleibt für Screenreader eindeutig */
  .kachel h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--r-gross); z-index: 1; }
  .kachel-medien {
    position: relative; aspect-ratio: 4 / 3; overflow: hidden; margin: 0 calc(-1 * clamp(1.5rem, 3vw, 2rem)) 1.25rem;
    display: grid; place-items: center; background: var(--sekundaer); color: var(--ueberschrift);
  }
  .kachel-medien :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Illustration: großes Linien-Icon auf feinem Punktraster */
  .illu { background: radial-gradient(circle, rgb(39 35 67 / 0.12) 1px, transparent 1.5px) 0 0 / 14px 14px, var(--sekundaer); border-bottom: 1.5px solid var(--ueberschrift); }
  .illu > :global(.symbol) { width: 4.5rem; height: 4.5rem; stroke-width: 1.25; }
  .kachel-medien > :global(.symbol) { width: 3.5rem; height: 3.5rem; }
  .kachel-symbol { display: none; }
  @media (hover: hover) { .kachel:has(a):hover { transform: translate(-3px, -3px); box-shadow: 7px 7px 0 var(--ueberschrift); } }
  .kachel :global(img) { transition: transform 400ms var(--ease-out); }
  @media (hover: hover) { .kachel:has(a):hover :global(img) { transform: scale(1.04); } }
  .kachel:has(a):active { transform: scale(0.98); transition-duration: 100ms; }
  .kachel:has(a:focus-visible) { outline: 3px solid var(--ueberschrift); outline-offset: 3px; }
  .kachel h3 a:focus-visible { outline: none; }
  .kachel-link { margin-top: auto; padding-top: 1rem; font-weight: 600; color: var(--ueberschrift); }
  .kachel-link::after { content: ' →'; }
  .kompakt { grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }
  .kompakt .kachel { padding: 0 1.25rem 1.4rem; }
  .kompakt .kachel-medien { margin-inline: -1.25rem; }
  .kompakt h3 { font-size: 1.15rem; }
  .kompakt p { font-size: 1rem; }
  .kompakt .kachel-link { display: none; }
  @media (prefers-reduced-motion: reduce) { .kachel:has(a):hover, .kachel:has(a):active { transform: none; } }
</style>
