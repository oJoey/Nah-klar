---
// Waagerechter Ablauf auf Navy: nummerierte Kreise in Gelb, durchgehende Linie. Auf dem Handy senkrecht.
export type AblaufSchritt = { titel: string; text: string };
interface Props { titel: string; schritte: AblaufSchritt[]; einleitung?: string }
const { titel, schritte, einleitung } = Astro.props;
const id = 'ablauf-' + Math.random().toString(36).slice(2, 7);
---
<section class="abschnitt abschnitt-dunkel ablauf" aria-labelledby={id} style={`--spalten:${schritte.length}`}>
  <div class="wrap">
    <div class="kopfzeile"><h2 id={id}>{titel}</h2>{einleitung && <p class="einleitung">{einleitung}</p>}</div>
    <ol class="ablauf-liste">
      {schritte.map((s, i) => (
        <li><span class="ablauf-nr" aria-hidden="true">{i + 1}</span><h3>{s.titel}</h3><p>{s.text}</p></li>
      ))}
    </ol>
  </div>
</section>
<style>
  .ablauf-liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; }
  .ablauf-liste li { position: relative; padding-left: 4.5rem; }
  .ablauf-nr { position: absolute; left: 0; top: 0; z-index: 1; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--ueberschrift); border: 2px solid var(--akzent); color: var(--akzent); font-weight: 800; font-size: 1.35rem; }
  .ablauf-liste li:not(:last-child)::before { content: ''; position: absolute; left: 1.55rem; top: 3.25rem; bottom: -2rem; width: 2px; background: rgb(255 216 3 / 0.35); }
  .ablauf h3 { font-size: 1.2rem; }
  .ablauf p { color: var(--sekundaer); margin: 0; }
  @media (min-width: 56rem) {
    .ablauf-liste { grid-template-columns: repeat(var(--spalten), 1fr); }
    .ablauf-liste li { padding-left: 0; padding-top: 4.75rem; padding-right: 1rem; }
    .ablauf-liste li:not(:last-child)::before { left: 3.25rem; right: -2rem; top: 1.55rem; bottom: auto; width: auto; height: 2px; }
  }
</style>
