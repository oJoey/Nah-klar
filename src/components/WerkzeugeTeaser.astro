---
// Erscheint automatisch, sobald mindestens ein Werkzeug oder Ratgeber live ist.
import Icon from './Icon.astro';
import { seiten, istLive, type SeitenSchluessel } from '../config/seiten';
import type { IconName } from '../lib/icons';
const teaser: { seite: SeitenSchluessel; icon: IconName; art: string; text: string }[] = [
  { seite: 'einwinterung', icon: 'liste', art: 'Checkliste', text: 'Schritt für Schritt: So machen Sie Wohnmobil und Wohnwagen winterfest.' },
  { seite: 'strassenCheck', icon: 'anhaenger', art: 'Werkzeug', text: 'Darf Ihr Wohnwagen oder Anhänger an der Straße stehen? Die 2-Wochen-Regel und ihre Ausnahmen.' },
  { seite: 'winterplatzVergleich', icon: 'hof', art: 'Ratgeber', text: 'Halle, Scheune oder Carport: Welcher Winterplatz passt zu Ihrem Fahrzeug?' },
];
const live = teaser.filter((t) => istLive(t.seite));
---
{live.length > 0 && (
  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <div class="kopfzeile"><h2>Werkzeuge und Ratgeber</h2></div>
      <ul class="raster werkzeuge">
        {live.map((t) => (
          <li class="werkzeug">
            <span class="werkzeug-bild" aria-hidden="true"><Icon name={t.icon} /></span>
            <div class="werkzeug-text">
              <p class="werkzeug-art">{t.art}</p>
              <h3><a href={seiten[t.seite].pfad}>{seiten[t.seite].titel}</a></h3>
              <p>{t.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .werkzeuge { gap: 1.25rem; }
  .werkzeug { position: relative; display: flex; gap: 1.25rem; align-items: flex-start; background: var(--karte); border-radius: var(--r-gross); padding: 1.25rem; transition: transform 200ms var(--ease-out); }
  .werkzeug-bild { flex: none; display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: var(--r); background: var(--marine); color: var(--akzent); }
  .werkzeug-bild :global(.symbol) { width: 2.25rem; height: 2.25rem; color: var(--akzent); stroke-width: 1.5; }
  .werkzeug-art { margin: 0 0 0.25rem; font-size: 0.875rem; font-weight: 700; color: var(--text-2); }
  .werkzeug h3 { font-size: 1.15rem; margin-bottom: 0.35rem; }
  .werkzeug h3 a { color: inherit; text-decoration: none; }
  .werkzeug h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--r-gross); }
  .werkzeug p:last-child { margin: 0; font-size: 1rem; color: var(--text-2); }
  .werkzeug:has(a:focus-visible) { outline: 3px solid var(--fokus); outline-offset: 3px; }
  .werkzeug h3 a:focus-visible { outline: none; }
  @media (hover: hover) { .werkzeug:hover { transform: translateY(-3px); } .werkzeug:hover h3 { text-decoration: underline; } }
  @media (prefers-reduced-motion: reduce) { .werkzeug:hover { transform: none; } }
</style>
