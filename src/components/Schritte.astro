---
// Vier Schritte, optional umschaltbar zwischen Mieter und Vermieter.
export type Schritt = { titel: string; text: string };
interface Props { mieter?: Schritt[]; vermieter?: Schritt[]; }
const { mieter, vermieter } = Astro.props;
const umschaltbar = !!(mieter && vermieter);
const gruppen = [
  { id: 'mieter', titel: 'Für Mieter', schritte: mieter },
  { id: 'vermieter', titel: 'Für Vermieter', schritte: vermieter },
].filter((g) => g.schritte);
---
<div class="schritte" data-umschalter={umschaltbar ? '' : undefined}>
  {umschaltbar && (
    <div class="umschalter" role="tablist" aria-label="Ablauf anzeigen für" hidden>
      {gruppen.map((g, i) => (
        <button type="button" role="tab" id={`tab-${g.id}`} aria-controls={`ablauf-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{g.titel}</button>
      ))}
    </div>
  )}
  {gruppen.map((g) => (
    <div id={`ablauf-${g.id}`} role={umschaltbar ? 'tabpanel' : undefined} aria-labelledby={umschaltbar ? `tab-${g.id}` : undefined}>
      {umschaltbar && <h3 class="schritte-gruppe">{g.titel}</h3>}
      <ol class="schritt-liste">
        {g.schritte!.map((s) => <li><h3>{s.titel}</h3><p>{s.text}</p></li>)}
      </ol>
      {g.id === 'vermieter' && !umschaltbar && <p class="kostenlos">Für Vermieter immer kostenlos</p>}
    </div>
  ))}
</div>
<script>
  // Ohne JavaScript sind beide Abläufe sichtbar; mit JavaScript wird umgeschaltet.
  document.querySelectorAll<HTMLElement>('[data-umschalter]').forEach((box) => {
    const leiste = box.querySelector<HTMLElement>('[role=tablist]')!;
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const zeige = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const an = t === tab;
        t.setAttribute('aria-selected', String(an));
        t.tabIndex = an ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !an;
      });
    };
    leiste.hidden = false;
    box.querySelectorAll('.schritte-gruppe').forEach((h) => h.classList.add('sr-only'));
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => zeige(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; zeige(n); n.focus(); }
      });
    });
    zeige(tabs[0]);
  });
</script>
<style>
.schritte { text-align: left; }
  .umschalter {
    display: flex; width: fit-content; margin: 0 auto 2.5rem; padding: 0.25rem;
    background: rgb(19 33 58 / 0.08); border-radius: var(--r-klein);
  }
  .umschalter button {
    min-height: 3rem; padding: 0.5rem 1.5rem; border: 0; border-radius: var(--r-klein);
    font: inherit; font-weight: 600; background: transparent; color: var(--text); cursor: pointer;
    transition: background-color 200ms ease, box-shadow 200ms ease;
  }
  .umschalter button[aria-selected='true'] { background: var(--hintergrund); color: var(--ueberschrift); box-shadow: 0 1px 3px rgb(0 0 0 / 0.12), 0 4px 10px rgb(0 0 0 / 0.06); }
  .schritt-liste { list-style: none; counter-reset: schritt; padding: 0; margin: 0 0 1.25rem; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .abschnitt-grau .schritt-liste li { background: var(--hintergrund); border-color: transparent; box-shadow: var(--schatten); }
  .schritt-liste li { counter-increment: schritt; background: var(--hintergrund); border: 1px solid var(--linie); border-radius: var(--r-gross); padding: 1.75rem; }
  .schritt-liste li::before {
    content: counter(schritt); display: block; margin-bottom: 0.75rem;
    font-size: 2.5rem; font-weight: 700; line-height: 1; letter-spacing: -0.03em; color: var(--ueberschrift);
    font-variant-numeric: tabular-nums;
  }
  .schritt-liste p { margin: 0; color: var(--text); }
  .schritte-gruppe { margin-top: 1.5rem; }
  [role='tabpanel'] > .kostenlos { text-align: center; }
</style>
