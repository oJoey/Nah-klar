---
import { link } from '../config/seiten';
// mieterZuerst: „Platz finden“ als Haupt-Button (Startseite), sonst „Platz anbieten“.
interface Props { finden?: boolean; mieterZuerst?: boolean; }
const { finden = true, mieterZuerst = false } = Astro.props;
---
<div class="button-paar">
  {mieterZuerst ? (
    <>
      <div>
        <a class="btn btn-primaer btn-gross" href={link('suchauftrag')}>Platz finden</a>
        <p class="unter-hinweis">Suchauftrag in 1 Minute, kostenlos</p>
      </div>
      <div>
        <a class="btn btn-rahmen btn-gross" href={link('vermieten')}>Platz anbieten</a>
        <p class="unter-hinweis">Für Vermieter kostenlos</p>
      </div>
    </>
  ) : (
    <>
      <div>
        <a class="btn btn-primaer btn-gross" href={link('platzAnbieten')}>Platz anbieten</a>
        <p class="unter-hinweis">Unverbindlich, in 2 Minuten</p>
      </div>
      {finden && (
        <div>
          <a class="btn btn-rahmen btn-gross" href={link('suchauftrag')}>Platz finden</a>
          <p class="unter-hinweis">Suchauftrag in 1 Minute, kostenlos</p>
        </div>
      )}
    </>
  )}
</div>
