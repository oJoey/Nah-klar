---
import aktion from '../config/aktion.json';
import { link, type SeitenSchluessel } from '../config/seiten';
// Beim Bauen prüfen; im Browser zusätzlich, damit der Balken auch ohne neuen Build verschwindet.
const ende = new Date(`${aktion.ende}T23:59:59+01:00`);
const sichtbar = aktion.aktiv && new Date() <= ende;
const href = link(aktion.link as SeitenSchluessel);
---
{sichtbar && (
  <div class="aktion" data-ende={ende.toISOString()}>
    <p class="wrap">
      {aktion.text}{' '}{href && <a href={href}>{aktion.linkText}</a>}
    </p>
  </div>
  <script is:inline>
    document.querySelectorAll('.aktion[data-ende]').forEach(function (el) {
      if (new Date() > new Date(el.dataset.ende)) el.remove();
    });
  </script>
)}
<style>
.aktion { background: var(--marine); color: #fff; text-align: center; }
  .aktion p { margin-block: 0; padding-block: 0.6rem; font-size: 0.9375rem; font-weight: 500; line-height: 1.4; }
  .aktion a { color: var(--messing-hell); font-weight: 600; white-space: nowrap; }
</style>
