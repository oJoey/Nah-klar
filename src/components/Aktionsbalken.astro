---
// Startaktion (site.startaktion): nur auf der Startseite und auf Seiten für Mieter, nie auf Vermieter-Seiten.
// Endet automatisch: beim Bauen geprüft und zusätzlich im Browser über data-aktion-bis (Skript in Basis.astro).
import { site } from '../config/site';
import { link } from '../config/seiten';
import { startaktionLaeuft, aktionsEnde } from '../lib/texte';
const pfad = Astro.url.pathname;
const mieterSeite = pfad === '/' || pfad.startsWith('/mieten') || pfad.startsWith('/suchauftrag') || pfad.startsWith('/preise');
const sichtbar = mieterSeite && startaktionLaeuft();
const href = link('suchauftrag');
---
{sichtbar && (
  <div class="aktion" data-aktion-bis={aktionsEnde.toISOString()}>
    <p class="wrap">{site.startaktion.text}.{' '}{href && <a href={href}>Suchauftrag anlegen</a>}</p>
  </div>
)}
<style>
  .aktion { background: var(--ueberschrift); text-align: center; }
  .aktion p { margin-block: 0; padding-block: 0.6rem; font-size: 0.9375rem; font-weight: 500; line-height: 1.4; color: var(--sekundaer); }
  .aktion a { color: var(--akzent); font-weight: 600; white-space: nowrap; }
</style>
