---
import richtwerte from '../data/richtwerte.json';
import { link } from '../config/seiten';
interface Props { ausfuehrlich?: boolean; }
const { ausfuehrlich = false } = Astro.props;
const arten = richtwerte.arten;
const start = arten[0];
const startMiete = Math.round((start.von + start.bis) / 2);
const euro = (n: number) => n.toLocaleString('de-DE') + ' €';
const vollerRechner = link('verdienstrechner');
---
<div class="rechner formular-karte" data-richtwerte={JSON.stringify(arten)}>
  <div>
    <div class="feld">
      <label for="rechner-art">Art der Fläche</label>
      <select id="rechner-art" name="art">
        {arten.map((a) => <option value={a.wert}>{a.titel}</option>)}
      </select>
    </div>
    <div class="feld">
      <label for="rechner-miete">Monatsmiete in Euro</label>
      <input id="rechner-miete" name="miete" type="number" inputmode="numeric" min="0" max="2000" step="5" value={startMiete} />
      <span class="feld-hilfe" data-richtwert>Richtwert: {start.von}–{start.bis} € pro Monat (Schätzung)</span>
    </div>
    {ausfuehrlich && (
      <div class="feld">
        <label for="rechner-anzahl">Anzahl Plätze</label>
        <input id="rechner-anzahl" name="anzahl" type="number" inputmode="numeric" min="1" max="20" value="1" />
        <span class="feld-hilfe">Zum Beispiel mehrere Stellplätze auf einem Hof</span>
      </div>
    )}
  </div>
  <div class="rechner-ausgabe">
  <p class="rechner-ergebnis">
    Möglicher Jahresertrag<output for="rechner-art rechner-miete" aria-live="polite" data-ergebnis>ca. {euro(startMiete * 12)}</output>
  </p>
  <p class="unter-hinweis">
    Schätzung, keine Zusage. Die Richtwerte sind Erfahrungswerte, der tatsächliche Preis hängt von Lage und Ausstattung ab. Sie bestimmen den Preis selbst und erhalten die volle Miete.
  </p>
  {ausfuehrlich && <p class="unter-hinweis kostenlos">Für Vermieter immer kostenlos</p>}
  {vollerRechner && <p class="mt"><a class="weiter" href={vollerRechner}>Zum ausführlichen Verdienstrechner</a></p>}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.rechner').forEach((box) => {
    const werte: { wert: string; von: number; bis: number }[] = JSON.parse(box.dataset.richtwerte ?? '[]');
    const art = box.querySelector<HTMLSelectElement>('[name=art]')!;
    const miete = box.querySelector<HTMLInputElement>('[name=miete]')!;
    const anzahl = box.querySelector<HTMLInputElement>('[name=anzahl]');
    const ergebnis = box.querySelector<HTMLOutputElement>('[data-ergebnis]')!;
    const richtwert = box.querySelector<HTMLElement>('[data-richtwert]')!;
    const fmt = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const rechne = () => {
      const m = Math.max(0, Number(miete.value) || 0);
      const n = anzahl ? Math.max(1, Number(anzahl.value) || 1) : 1;
      ergebnis.textContent = 'ca. ' + fmt.format(m * n * 12);
    };
    art.addEventListener('change', () => {
      const w = werte.find((x) => x.wert === art.value);
      if (w) {
        miete.value = String(Math.round((w.von + w.bis) / 2));
        richtwert.textContent = `Richtwert: ${w.von}–${w.bis} € pro Monat (Schätzung)`;
      }
      rechne();
    });
    miete.addEventListener('input', rechne);
    anzahl?.addEventListener('input', rechne);
  });
</script>
<style>
.rechner { display: grid; gap: 2rem; }
  @media (min-width: 52rem) { .rechner { grid-template-columns: 1.1fr 1fr; align-items: center; padding: 2.5rem; } }
  .rechner-ergebnis { margin: 0; font-size: 1.15rem; font-weight: 600; color: var(--text-2); }
  .rechner-ergebnis output {
    display: block; margin-top: 0.25rem; color: var(--text);
    font-size: clamp(2.75rem, 8vw, 4rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .rechner-ausgabe { background: var(--blau-hell); border-radius: var(--r); padding: 1.5rem; }
</style>
