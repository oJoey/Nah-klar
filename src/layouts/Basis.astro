---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { site } from '../config/site';
import { jsonLd } from '../lib/texte';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import Brotkruemel, { type Kruemel } from '../components/Brotkruemel.astro';

interface Props {
  titel: string;
  beschreibung: string;
  brotkruemel?: Kruemel[];
  noindex?: boolean;
}
const { titel, beschreibung, brotkruemel, noindex = false } = Astro.props;
// Nur auf der echten Domain zählen, nicht in Vorschau-Deploys. Solange die Domain ein Platzhalter ist, ohne Einschränkung.
const umamiDomain = site.url.includes('domain-eintragen') ? undefined : new URL(site.url).hostname;
const canonical = new URL(Astro.url.pathname, site.url).href;
const volltitel = Astro.url.pathname === '/' ? titel : `${titel} | ${site.name}`;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organisation`,
  name: site.name,
  url: site.url,
  description: site.beschreibung,
  areaServed: { '@type': 'AdministrativeArea', name: site.region },
  contactPoint: { '@type': 'ContactPoint', email: site.email, contactType: 'customer service', areaServed: 'DE', availableLanguage: 'de' },
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  inLanguage: 'de-DE',
  publisher: { '@id': `${site.url}/#organisation` },
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{volltitel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#fffffe" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={jsonLd(organisation)} />
    <script type="application/ld+json" set:html={jsonLd(website)} />
    <script is:inline>
      // Herkunft merken (UTM, Flyer-Quelle), damit sie im Formular mitgeschickt werden kann.
      try {
        var p = new URLSearchParams(location.search), o = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'quelle', 'ref'].forEach(function (k) {
          var v = p.get(k); if (v) o[k] = v.slice(0, 80);
        });
        if (Object.keys(o).length) { o.einstieg = location.pathname; sessionStorage.setItem('herkunft', JSON.stringify(o)); }
      } catch (e) {}
    </script>
    {site.umami.websiteId && (
      <script is:inline defer src={site.umami.skript} data-website-id={site.umami.websiteId} data-domains={umamiDomain} data-do-not-track={site.umami.respektiereDnt ? 'true' : undefined}></script>
    )}
    {site.umami.websiteId && (
      <script is:inline>
        // Klicks auf WhatsApp, E-Mail und die beiden Hauptwege sowie abgeschickte Formulare als Ereignis zählen (ohne personenbezogene Daten).
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]'); if (!a || !window.umami) return;
          var h = a.getAttribute('href'), name = '';
          if (h.indexOf('https://wa.me/') === 0) name = 'kontakt-whatsapp';
          else if (h.indexOf('mailto:') === 0) name = 'kontakt-email';
          else if (h.indexOf('/suchauftrag/') === 0) name = 'weg-suchauftrag';
          else if (h.indexOf('/platz-anbieten/') === 0) name = 'weg-platz-anbieten';
          if (name) window.umami.track(name, { seite: location.pathname });
        });
        document.addEventListener('submit', function (e) {
          var f = e.target; if (!window.umami || !f.getAttribute) return;
          window.umami.track('formular-' + (f.getAttribute('name') || 'suche'), { seite: location.pathname });
        });
      </script>
    )}
  </head>
  <body>
    <a class="sr-only sprung" href="#inhalt">Zum Inhalt springen</a>
    <Kopf />
    {brotkruemel && <Brotkruemel pfadListe={brotkruemel} />}
    <main id="inhalt">
      <slot />
    </main>
    <Fuss />
  </body>
</html>
<style>
  .sprung:focus { position: static; width: auto; height: auto; margin: 0; clip: auto; display: block; padding: 0.75rem 1rem; background: var(--ueberschrift); color: var(--hintergrund); }
</style>
