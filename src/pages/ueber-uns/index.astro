---
import Ratgeber from '../../layouts/Ratgeber.astro';
import { site } from '../../config/site';
import { link } from '../../config/seiten';

// TODO: Persönliche Vorstellung (Name, Foto, warum Sie das machen) ergänzen. Das schafft am meisten Vertrauen.
const grundsaetze = [
  { titel: 'Persönlich statt anonym', text: 'Hinter jedem Vorschlag steht ein Mensch, kein Algorithmus. Sie haben einen festen Ansprechpartner per WhatsApp und E-Mail.' },
  { titel: 'Ehrlich über die Chancen', text: 'Wenn es in Ihrer Gegend gerade wenig Angebote gibt, sagen wir Ihnen das, statt Sie hinzuhalten.' },
  { titel: 'Kostenlos für Vermieter', text: 'Wer Platz zur Verfügung stellt, zahlt bei uns nichts und erhält die volle vereinbarte Miete.' },
  { titel: 'Regional', text: `Wir konzentrieren uns auf ${site.region}, von Mannheim bis zum Bodensee, und kennen die Gegebenheiten vor Ort.` },
];
---
<Ratgeber
  seite="ueberUns"
  eltern={null}
  typ="AboutPage"
  titel={`Über uns: Wer hinter ${site.name} steht`}
  beschreibung={`${site.name} bringt Menschen mit freiem Platz und Menschen mit Platzbedarf ${site.regionIn} zusammen: persönlich, regional und kostenlos für Vermieter.`}
  kicker="Über uns"
  einleitung="Nachbarn helfen sich: ungenutzter Platz gegen einen fairen Nebenverdienst."
  verwandt={['soFunktionierts', 'sicherheit', 'kontakt']}
>
  <Fragment slot="h1">Platz ist da. Er muss nur <span class="markiert">gefunden</span> werden.</Fragment>

  <section class="abschnitt">
    <div class="wrap inhalt">
      <h2>Warum es uns gibt</h2>
      <p>Wohnmobile, Wohnwagen und Anhänger werden immer mehr, Stellplätze und Garagen in Städten immer knapper. Gleichzeitig stehen Einfahrten, Scheunen, Hallen und Keller leer, oft nur ein paar Straßen weiter.</p>
      <p>Über Kleinanzeigen finden diese beiden Seiten selten zusammen: Vermieter scheuen den Aufwand und das Risiko mit Fremden, Suchende klicken sich durch veraltete Inserate. Genau da setzen wir an.</p>
      <h2>Was wir tun</h2>
      <p>Wir bringen Mieter und Vermieter von Stellplätzen, Garagen und Lagerräumen {site.regionIn} zusammen. Nicht als Portal mit tausend Anzeigen, sondern von Hand: Wir prüfen jede Fläche, schlagen passende Plätze und Mieter vor und sorgen mit Mustervertrag und Kaution für klare Verhältnisse.</p>
      <p>Wie das genau abläuft, steht unter <a href={link('soFunktionierts')}>So funktioniert's</a>.</p>
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <div class="kopfzeile"><h2>Woran wir uns halten</h2></div>
      <ul class="raster">
        {grundsaetze.map((g) => <li class="karte"><h3>{g.titel}</h3><p class="grundsatz">{g.text}</p></li>)}
      </ul>
    </div>
  </section>
</Ratgeber>
<style>
  .grundsatz { margin: 0; color: var(--text); }
</style>
