---
import Basis from '../../layouts/Basis.astro';
import FlaecheMelden from '../../components/FlaecheMelden.astro';
import FormSkript from '../../components/FormSkript.astro';
import { site, whatsappLink, emailHref } from '../../config/site';
---
<Basis
  titel="Platz anbieten: Garage, Stellplatz, Scheune oder Lagerraum vermieten"
  beschreibung="Bieten Sie Ihren freien Platz in Baden-Württemberg an. Für Vermieter immer kostenlos: Sie bestimmen den Preis, wir melden uns mit passenden Mietern."
  brotkruemel={[{ name: 'Vermieten', pfad: '/vermieten/' }, { name: 'Platz anbieten', pfad: '/platz-anbieten/' }]}
>
  <section class="abschnitt abschnitt-grau formular-seite">
    <div class="wrap schmal">
      <h1>Platz anbieten</h1>
      <p class="einleitung">Wenige kurze Schritte. Wir prüfen Fotos und Angaben und melden uns persönlich, {site.antwortzeit}. Fragen? Schreiben Sie uns per <a href={whatsappLink} rel="noopener">WhatsApp</a> oder <a href={emailHref}>E-Mail</a>.</p>
      <FlaecheMelden />
    </div>
  </section>
  <FormSkript />
</Basis>
<style>
  .formular-seite { padding-top: clamp(1.5rem, 5vw, 3.5rem); }
  .formular-seite h1 { font-size: clamp(2.1rem, 6vw, 3.25rem); }
  .schmal { max-width: 46rem; }
</style>
