---
import Basis from '../../layouts/Basis.astro';
import FlaecheMelden from '../../components/FlaecheMelden.astro';
import FormSkript from '../../components/FormSkript.astro';
import { site, telefonHref } from '../../config/site';
---
<Basis
  titel="Fläche melden – Garage, Stellplatz, Scheune oder Lagerraum vermieten"
  beschreibung="Melden Sie Ihre freie Fläche in Baden-Württemberg. Für Vermieter immer kostenlos – Sie bestimmen den Preis, wir melden uns mit passenden Mietern."
  brotkruemel={[{ name: 'Vermieten', pfad: '/vermieten/' }, { name: 'Fläche melden', pfad: '/platz-anbieten/' }]}
>
  <section class="abschnitt abschnitt-grau formular-seite">
    <div class="wrap schmal">
      <h1>Fläche melden</h1>
      <p class="einleitung">Drei kurze Schritte. Wir prüfen Fotos und Angaben und melden uns persönlich, {site.antwortzeit}. Lieber telefonieren? <a href={telefonHref}>{site.telefonAnzeige}</a></p>
      <FlaecheMelden />
    </div>
  </section>
  <FormSkript />
</Basis>
<style>
  .formular-seite { padding-top: clamp(1.5rem, 5vw, 3.5rem); }
  .formular-seite h1 { font-size: clamp(2.1rem, 6vw, 3.25rem); }
  .schmal { max-width: 46rem; }
</style>
