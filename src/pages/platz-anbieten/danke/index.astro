---
import Basis from '../../../layouts/Basis.astro';
import Empfehlung from '../../../components/Empfehlung.astro';
import { site, whatsappLink, emailHref } from '../../../config/site';
import { link } from '../../../config/seiten';
---
<Basis titel="Danke für Ihr Angebot" beschreibung="Ihre Flächenmeldung ist bei uns angekommen." noindex>
  <section class="abschnitt">
    <div class="wrap schmal">
      <h1>Danke, Ihr Angebot ist angekommen.</h1>
      <p class="einleitung">Wir melden uns {site.antwortzeit} persönlich bei Ihnen.{site.bestaetigungsmail && ' Eine Bestätigung mit Ihren Angaben ist per E-Mail unterwegs.'}</p>
      <h2>So geht es weiter</h2>
      <ol>
        <li>Wir prüfen Fotos und Angaben und besprechen mit Ihnen Preis und Wünsche.</li>
        <li>Wir schlagen Ihnen passende Mieter vor. Sie entscheiden, wer einzieht.</li>
        <li>Besichtigung, Mustervertrag, Kaution. Danach läuft die Miete.</li>
      </ol>
      <p>Ehrlich gesagt: Wie schnell wir einen Mieter finden, hängt von Art und Lage ab. Wir sagen Ihnen offen, wie die Nachfrage in Ihrer Gegend aussieht.</p>
      <p class="kostenlos">Für Vermieter immer kostenlos</p>
      <p>Fragen? Schreiben Sie uns per <a href={whatsappLink} rel="noopener">WhatsApp</a> oder <a href={emailHref}>E-Mail</a>.</p>
      <Empfehlung />
    </div>
  </section>
</Basis>
<style>.schmal { max-width: 46rem; }</style>
