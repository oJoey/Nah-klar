---
import Ratgeber from '../../layouts/Ratgeber.astro';
import Schritte from '../../components/Schritte.astro';
import { site } from '../../config/site';
import { zahlung } from '../../config/zahlung';
import { link } from '../../config/seiten';
import { mieterSchritte, vermieterSchritte } from '../../data/ablauf';
import { texte } from '../../lib/texte';

const vertrag = [
  'Ort, Art und Größe des Platzes',
  'Monatsmiete und wie sie gezahlt wird',
  `Kaution: eine Monatsmiete, mindestens ${zahlung.kautionMinEuro} €`,
  `Kündigung: monatlich, mit einer Frist von ${zahlung.kuendigungsfristMonate === 1 ? 'einem Monat' : `${zahlung.kuendigungsfristMonate} Monaten`}`,
  'Zufahrt und Zugangszeiten',
  'Hausregeln, etwa keine Reparaturen auf dem Hof',
  'Zustand bei Ein- und Auszug, mit Fotos festgehalten',
];
---
<Ratgeber
  seite="soFunktionierts"
  eltern={null}
  typ="WebPage"
  titel="So funktioniert die Vermittlung von Stellplatz, Garage und Lagerraum"
  beschreibung={`Vom Suchauftrag bis zum Mietvertrag: So vermittelt ${site.name} Stellplätze, Garagen und Lagerräume zwischen Privatleuten ${site.regionIn}. Kostenlos für Vermieter, mit Mustervertrag und Kaution.`}
  kicker="So funktioniert's"
  einleitung="Kein Inserateportal, sondern persönliche Vermittlung: Sie sagen uns, was Sie suchen oder anbieten. Wir bringen die passenden Leute zusammen."
  verwandt={['preise', 'sicherheit', 'hilfe']}
>
  <Fragment slot="h1">Vom Suchauftrag zum <span class="markiert">Vertrag</span></Fragment>

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile"><h2>Der Ablauf in vier Schritten</h2></div>
      <Schritte mieter={mieterSchritte} vermieter={vermieterSchritte} />
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap inhalt">
      <h2>Was ist anders als bei Kleinanzeigen?</h2>
      <p>Bei einer Anzeige schreiben Sie selbst, verhandeln selbst und regeln alles per Handschlag. Bei uns prüfen wir jede Fläche von Hand, bevor wir sie vorschlagen. Anfragen laufen gebündelt über uns, die Telefonnummer des Vermieters steht nirgends öffentlich. Und am Ende gibt es einen schriftlichen Mustervertrag statt einer mündlichen Absprache.</p>
      <h2>Was steht im Mustervertrag?</h2>
      <ul class="haken">{vertrag.map((v) => <li>{v}</li>)}</ul>
      <p>Mieter und Vermieter können den Vertrag vor der Zusage in Ruhe lesen. Geschlossen wird er direkt zwischen beiden, wir vermitteln.</p>
      <h2>Was kostet das?</h2>
      <p>{texte.vermieterKosten}</p>
      <p>{texte.mieterKosten}</p>
      <p>Alle Einzelheiten stehen auf der Seite <a href={link('preise')}>Preise</a>.</p>
    </div>
  </section>
</Ratgeber>
