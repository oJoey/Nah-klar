---
import Ratgeber from '../../layouts/Ratgeber.astro';
import Schritte from '../../components/Schritte.astro';
import { site } from '../../config/site';
import { zahlung } from '../../config/zahlung';
import { link } from '../../config/seiten';
import { mieterSchritte, vermieterSchritte } from '../../data/ablauf';
import { texte } from '../../lib/texte';

---
<Ratgeber
  seite="soFunktionierts"
  eltern={null}
  typ="WebPage"
  titel="So funktioniert es: Abstellplatz für Wohnmobil und Lagerraum finden oder vermieten"
  beschreibung={`Von der Suche bis zur Besichtigung: So bringt ${site.name} Mieter und Vermieter von Abstellplätzen für Wohnmobile und Wohnwagen sowie Lagerräumen ${site.regionIn} zusammen. Vor der Besichtigung zahlen Mieter nichts.`}
  kicker="So funktioniert's"
  einleitung="Die Plattform, die Mieter und Vermieter zusammenbringt: Inserate ansehen, Besichtigung anfragen, erst dann buchen."
  verwandt={['preise', 'sicherheit', 'hilfe']}
>
  <Fragment slot="h1">Von der Suche zur <span class="markiert">Besichtigung</span></Fragment>

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile"><h2>Der Ablauf in vier Schritten</h2></div>
      <Schritte mieter={mieterSchritte} vermieter={vermieterSchritte} />
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap inhalt">
      <h2>Was ist anders als bei Kleinanzeigen?</h2>
      <p>Bei einer Anzeige schreiben Sie selbst, verhandeln selbst und regeln alles per Handschlag. Bei uns prüfen wir jedes Inserat, bevor es online geht. Anfragen laufen gebündelt über uns, die Telefonnummer des Vermieters steht nirgends öffentlich. Und vor der Besichtigung zahlen Sie nichts.</p>
    </div>
  </section>
</Ratgeber>
