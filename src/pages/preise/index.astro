---
import Ratgeber from '../../layouts/Ratgeber.astro';
import Richtwerte from '../../components/Richtwerte.astro';
import { site } from '../../config/site';
import { zahlung } from '../../config/zahlung';
import { link } from '../../config/seiten';
import { texte } from '../../lib/texte';
const vermieterKostenlos = !zahlung.provisionAnzeigen;
---
<Ratgeber
  seite="preise"
  eltern={null}
  typ="WebPage"
  titel="Preise: Was kostet ein Platz für Wohnmobil, Wohnwagen oder Lagergut?"
  beschreibung={`Für Mieter ein fester Gesamtpreis, die Servicegebühr ist enthalten. Was Abstellplätze für Wohnmobil und Wohnwagen und Lagerräume ${site.regionIn} üblicherweise kosten.`}
  kicker="Preise"
  einleitung="Für Mieter ein fester Gesamtpreis pro Monat oder pro Saison. Vor der Besichtigung zahlen Sie nichts."
  verwandt={['soFunktionierts', 'verdienstrechner', 'winterplatzVergleich']}
>
  <Fragment slot="h1">Klare <span class="markiert">Preise</span>, keine Überraschungen</Fragment>

  <section class="abschnitt">
    <div class="wrap preis-raster">
      <div class="karte preis-karte">
        <p class="preis-wer">Für Mieter</p>
        <h2>Ein fester Gesamtpreis</h2>
        <ul class="haken">
          <li>{texte.mieterKosten}</li>
          {texte.servicegebuehr && <li>Die Servicegebühr von {texte.prozent} der Miete ist {texte.servicegebuehrZweck}.</li>}
          <li>Vor der Besichtigung zahlen Sie nichts.</li>
          <li>Kaution: eine Monatsmiete, mindestens {zahlung.kautionMinEuro} €, direkt an den Vermieter. Zurück innerhalb von {zahlung.kautionRueckzahlungWochen} Wochen nach dem Auszug, abzüglich belegter Schäden.</li>
          <li>Der Suchauftrag ist kostenlos und unverbindlich.</li>
        </ul>
      </div>
      <div class="karte preis-karte">
        <p class="preis-wer">Für Vermieter</p>
        <h2>{vermieterKostenlos ? <span class="kostenlos">Anbieten kostenlos</span> : 'Einmalige Provision'}</h2>
        <ul class="haken">
          <li>{texte.vermieterKosten}</li>
          <li>Sie legen den Preis selbst fest. Auf Wunsch sagen wir Ihnen, was in Ihrer Gegend üblich ist.</li>
          <li>Keine Grundgebühr, keine Laufzeit bei uns.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Was kostet ein Platz im Monat?</h2>
        <p class="einleitung">Übliche Monatspreise nach Art und Fahrzeuglänge. Den genauen Gesamtpreis sehen Sie bei jedem Inserat.</p>
      </div>
      <Richtwerte />
      <p class="mt"><a class="weiter" href={link('suchauftrag')}>Passenden Platz suchen lassen</a></p>
    </div>
  </section>
</Ratgeber>
<style>
  .preis-raster { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .preis-karte { border: 1.5px solid var(--ueberschrift); box-shadow: 4px 4px 0 var(--ueberschrift); }
  .preis-karte .haken { margin: 0; }
  .preis-wer { margin: 0 0 0.25rem; font-weight: 700; font-size: 0.95rem; }
</style>
