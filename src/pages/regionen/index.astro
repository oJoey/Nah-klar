---
import Ratgeber from '../../layouts/Ratgeber.astro';
import { site } from '../../config/site';
import { link } from '../../config/seiten';

// Orte im Einzugsgebiet. Links öffnen den Suchauftrag mit vorausgefülltem Ort (Ortsseiten folgen mit den SEO-Seiten).
const bezirke = [
  { titel: 'Landkreis Böblingen', staedte: ['Böblingen', 'Sindelfingen', 'Herrenberg', 'Leonberg', 'Holzgerlingen', 'Renningen', 'Weil der Stadt', 'Gärtringen', 'Ehningen', 'Schönaich', 'Weil im Schönbuch', 'Magstadt'] },
  { titel: 'Stuttgart und Umgebung', staedte: ['Stuttgart', 'Leinfelden-Echterdingen', 'Filderstadt', 'Ostfildern', 'Esslingen am Neckar', 'Ludwigsburg', 'Ditzingen', 'Gerlingen', 'Korntal-Münchingen', 'Waiblingen'] },
];
const such = link('suchauftrag');
const ortLink = (ort: string) => (such ? `${such}?ort=${encodeURIComponent(ort)}` : null);
---
<Ratgeber
  seite="regionen"
  eltern={null}
  typ="CollectionPage"
  titel={`Platz für Wohnmobil, Wohnwagen und Lagergut: Orte im Raum ${site.region}`}
  beschreibung={`Abstellplatz für Wohnmobil und Wohnwagen oder Lagerraum mieten und vermieten ${site.regionIn}: Böblingen, Sindelfingen, Herrenberg, Leonberg, Stuttgart und Umgebung.`}
  kicker="Regionen"
  einleitung={`Wir bringen Mieter und Vermieter ${site.regionIn} zusammen, in der Stadt und im Umland.`}
  verwandt={['mieten', 'vermieten', 'preise']}
>
  <Fragment slot="h1">Platz finden im Raum <span class="markiert">{site.region}</span></Fragment>

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Wo suchen Sie?</h2>
        <p class="einleitung">Wählen Sie Ihre Stadt, der Ort wird im Suchauftrag schon eingetragen. Ihr Ort ist nicht dabei? Geben Sie ihn im Suchauftrag einfach selbst ein.</p>
      </div>
      {link('regionBoeblingen') && <p class="region-link"><a class="weiter" href={link('regionBoeblingen')}>Alles zum Landkreis Böblingen</a></p>}
      <div class="bezirke">
        {bezirke.map((b) => (
          <div>
            <h3>{b.titel}</h3>
            <ul class="orte">
              {b.staedte.map((s) => { const href = ortLink(s); return <li>{href ? <a href={href} rel="nofollow">{s}</a> : s}</li>; })}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap inhalt">
      <h2>Stadt oder Land: Was Sie erwarten können</h2>
      <h3>In den Städten</h3>
      <p>In Stuttgart, Böblingen und Sindelfingen ist Platz knapp und teurer. Für Wohnmobile gibt es in der Stadt selbst kaum Platz, oft findet sich aber etwas in den Orten am Stadtrand.</p>
      <h3>Im Umland und auf dem Land</h3>
      <p>Scheunen, Hallen und große Höfe gibt es vor allem außerhalb der Städte. Hier finden sich die meisten Winterplätze für Wohnmobil und Wohnwagen, meist günstiger als in der Stadt.</p>
      <p>Wie schnell wir einen Platz finden, hängt davon ab, wie viele Angebote es in Ihrer Gegend gibt. Nach Ihrem Suchauftrag sagen wir Ihnen ehrlich, wie die Chancen stehen.</p>
      <p>Sie haben selbst Platz frei? <a href={link('platzAnbieten')}>Platz anbieten</a>, kostenlos.</p>
    </div>
  </section>
</Ratgeber>
<style>
  .bezirke { display: grid; gap: 2rem 3rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .bezirke h3 { font-size: 1.15rem; }
  .orte { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  .orte a { display: inline-block; min-height: 2.75rem; padding-block: 0.5rem; font-weight: 600; }
</style>
