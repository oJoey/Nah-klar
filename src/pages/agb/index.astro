---
// PLATZHALTER: Die AGB schreibt bzw. prüft ein Anwalt. Bis dahin noindex und nicht in der Sitemap.
// Der frühere Entwurf (Phase mit Formularen) liegt in der Git-Historie dieser Datei.
// Offene Fragen für die Prüfung: docs/rechtstexte-pruefung.md
import Basis from '../../layouts/Basis.astro';
import { site, emailHref } from '../../config/site';

// Themen, die der Anwalt regeln soll (nur als Gliederung, kein Rechtstext).
const themen = [
  'Geltungsbereich und Anbieter',
  'Rolle der Plattform, die Mieter und Vermieter zusammenbringt (nicht Vertragspartei des Mietvertrags)',
  'Konto und Anmeldung',
  'Inserate: Pflichten der Vermieter, Prüfung, Sperrung',
  'Anfrage, Besichtigung und Buchung',
  'Gebühren: Servicegebühr für Mieter, einmalige Provision für Vermieter',
  'Zahlungsabwicklung über einen Zahlungsdienstleister',
  'Nachrichten und Weitergabe von Kontaktdaten',
  'Meldungen zu Inseraten',
  'Haftung',
  'Laufzeit und Kündigung',
  'Widerrufsbelehrung',
  'Schlussbestimmungen',
];
---
<Basis titel="Allgemeine Geschäftsbedingungen" beschreibung={`AGB von ${site.name}.`} brotkruemel={[{ name: 'AGB', pfad: '/agb/' }]} noindex>
  <section class="abschnitt">
    <div class="wrap rechtstext">
      <h1>Allgemeine Geschäftsbedingungen</h1>
      <p class="einleitung">Die Allgemeinen Geschäftsbedingungen werden derzeit erstellt und erscheinen hier vor dem Start.</p>
      <p>Geregelt werden unter anderem:</p>
      <ol>
        {themen.map((t) => <li>{t}</li>)}
      </ol>
      <p class="stand">Fragen? <a href={emailHref}>{site.email}</a></p>
    </div>
  </section>
</Basis>
