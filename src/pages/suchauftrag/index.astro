---
import Basis from '../../layouts/Basis.astro';
import SuchauftragFormular from '../../components/SuchauftragFormular.astro';
import FormSkript from '../../components/FormSkript.astro';
import { link } from '../../config/seiten';
---
<Basis
  titel="Suchauftrag anlegen – Stellplatz, Garage oder Lagerraum"
  beschreibung="Kostenloser Suchauftrag für Stellplatz, Garage, Winterplatz oder Lagerraum in Baden-Württemberg. Ohne Konto, keine Werbemails, jederzeit löschbar."
  brotkruemel={[{ name: 'Mieten', pfad: '/mieten/' }, { name: 'Suchauftrag', pfad: '/suchauftrag/' }]}
>
  <section class="abschnitt abschnitt-grau formular-seite">
    <div class="wrap schmal">
      <h1>Suchauftrag anlegen</h1>
      <p class="einleitung">In einer Minute, ohne Konto. Wir melden uns mit passenden Plätzen, mit Fotos, Preis und Ortsteil.</p>
      <SuchauftragFormular />
      <p class="mt">Sie möchten selbst Platz vermieten? <a href={link('vermieten')}>Fläche melden</a>, für Vermieter kostenlos.</p>
    </div>
  </section>
  <FormSkript />
</Basis>
<style>
  .formular-seite { padding-top: clamp(1.5rem, 5vw, 3.5rem); }
  .formular-seite h1 { font-size: clamp(2.1rem, 6vw, 3.25rem); }
  .schmal { max-width: 46rem; }
</style>
