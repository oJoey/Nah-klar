---
import Basis from '../../../layouts/Basis.astro';
import Empfehlung from '../../../components/Empfehlung.astro';
import { site, whatsappLink, emailHref } from '../../../config/site';
import { link } from '../../../config/seiten';
import { texte } from '../../../lib/texte';

const erwartung = [
  { art: 'Wohnmobil und Wohnwagen', text: 'Wir fragen gezielt bei Höfen, Scheunen und großen Grundstücken in Ihrer Umgebung nach.' },
  { art: 'Lagerraum', text: 'Freie Lagerräume sind seltener. Auch hier kann es etwas länger dauern.' },
];
---
<Basis titel="Danke für Ihren Suchauftrag" beschreibung="Ihr Suchauftrag ist bei uns angekommen." noindex>
  <section class="abschnitt">
    <div class="wrap schmal">
      <h1>Danke, Ihr Suchauftrag ist angekommen.</h1>
      <p class="einleitung">Wir melden uns {site.antwortzeit} bei Ihnen.{site.bestaetigungsmail && ' Eine Bestätigung mit Ihren Angaben ist per E-Mail unterwegs.'}</p>
      <h2>Womit Sie rechnen können</h2>
      <p>Wie schnell wir einen Platz finden, hängt vom Ort und von der Art ab. Wir sagen Ihnen ehrlich, wie es in Ihrer Gegend aussieht.</p>
      <ul class="haken">
        {erwartung.map((e) => <li><strong>{e.art}:</strong> {e.text}</li>)}
      </ul>
      <p>Der Suchauftrag ist kostenlos und unverbindlich.</p>
      <p>Fragen? {site.ansprechpartner} per <a href={whatsappLink} rel="noopener">WhatsApp</a> oder <a href={emailHref}>E-Mail</a>.</p>
      <Empfehlung />
      <p class="mt"><a href={link('start')}>Zur Startseite</a></p>
    </div>
  </section>
</Basis>
<style>.schmal { max-width: 46rem; }</style>
