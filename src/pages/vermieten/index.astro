---
import { vermieterSchritte } from '../../data/ablauf';
import Basis from '../../layouts/Basis.astro';
import Kacheln from '../../components/Kacheln.astro';
import Ertragsrechner from '../../components/Ertragsrechner.astro';
import Vorteile from '../../components/Vorteile.astro';
import Ablauf from '../../components/Ablauf.astro';
import Vergleich from '../../components/Vergleich.astro';
import FlaecheMelden from '../../components/FlaecheMelden.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import SmartLink from '../../components/SmartLink.astro';
import Bildplatz from '../../components/Bildplatz.astro';
import FormSkript from '../../components/FormSkript.astro';
import { site, whatsappLink, emailHref } from '../../config/site';
import { link, seiten, istLive } from '../../config/seiten';
import { zahlung } from '../../config/zahlung';
import { flaechenArten } from '../../data/arten';
import NachfrageHinweis from '../../components/NachfrageHinweis.astro';
import { texte } from '../../lib/texte';
import richtwerte from '../../data/richtwerte.json';

// Beispiel im Hero: Werte aus richtwerte.json (Halle/Scheune bis 7 m), damit Beispiel und Rechner zusammenpassen
const beispielPreis = richtwerte.arten.find((a) => a.wert === 'halle-scheune')!.preise!['7']!;
const jahr = (n: number) => (Math.round((n * 12) / 10) * 10).toLocaleString('de-DE');
const beispiel = { titel: 'Hallenplatz in Sindelfingen', groesse: 'Wohnmobil bis 7 m', von: jahr(beispielPreis[0]), bis: jahr(beispielPreis[1]) };

const kacheln = flaechenArten.map((a) => ({
  titel: a.titel,
  text: a.nutzen,
  icon: a.icon,
  href: link(a.seite),
  bild: a.bild,
  linkText: istLive(a.seite) ? 'Mehr erfahren' : 'Jetzt anbieten',
}));

const sorgen = [
  { titel: 'Fremde auf dem Grundstück?', text: site.mieterPruefung
      ? 'Wir prüfen jeden Mieter vorab: Ausweis, bei Fahrzeugen auch Fahrzeugschein und Versicherung. Sie lernen den Mieter bei der Besichtigung kennen und entscheiden selbst, ob Sie vermieten.'
      : 'Sie lernen jeden Interessenten bei der Besichtigung kennen und entscheiden selbst, ob Sie vermieten. Anfragen laufen gebündelt über uns, Ihre Telefonnummer steht nirgends öffentlich.' },
  { titel: 'Nachbarn: Gibt es Ärger?', text: 'Zufahrtszeiten und Regeln, etwa keine Reparaturen auf dem Hof, sprechen Sie vorher ab und nennen sie im Inserat. So wissen alle, woran sie sind.' },
];

// Vergleich aus Sicht der Vermieter. Nur, was es wirklich gibt.
const vergleich = [
  { punkt: 'Adresse', anzeige: 'Steht oft in der Anzeige', wir: 'Nur der Ortsteil ist öffentlich, die Adresse gibt es erst zur Besichtigung' },
  { punkt: 'Prüfung', anzeige: 'Jeder kann alles einstellen', wir: 'Jedes Inserat wird geprüft, bevor es online geht' },
  { punkt: 'Anfragen', anzeige: 'Viele Anrufe, Ihre Nummer steht öffentlich', wir: site.mieterPruefung ? 'Vorab geprüfte Interessenten, gebündelt über uns' : 'Nur passende Interessenten, gebündelt über uns' },
];

const schritte = vermieterSchritte;

---
<Basis
  titel="Abstellplatz für Wohnmobil oder Lagerraum vermieten im Raum Stuttgart und Böblingen"
  beschreibung="Hoffläche, Halle, Scheune, Garage oder Keller vermieten, mit fairem Nebenverdienst. Anbieten kostenlos: jedes Inserat geprüft, Adresse geschützt, persönlicher Ansprechpartner."
  brotkruemel={[{ name: 'Vermieten', pfad: '/vermieten/' }]}
>
  <section class="held-formular abschnitt-grau">
    <div class="held-muster" aria-hidden="true"></div>
    <div class="wrap held-raster">
      <div class="held-text">
        <p class="kicker">Abstellplatz für Wohnmobil oder Lagerraum vermieten</p>
        <h1>Leerer Platz? Machen Sie <span class="markiert">Miete</span> daraus.</h1>
        <p class="einleitung">Anbieten kostenlos. Sie bestimmen den Preis.</p>
        <ul class="held-punkte">
          <li><span class="held-icon"><Icon name="schild" /></span>Jede Fläche von Hand geprüft</li>
          <li><span class="held-icon"><Icon name="ort" /></span>Adresse bleibt privat</li>
          <li><span class="held-icon"><Icon name="chat" /></span>Persönlicher Ansprechpartner per WhatsApp und E-Mail</li>
        </ul>
        <a class="beispiel" href="#rechner">
          <span class="beispiel-icon" aria-hidden="true"><Icon name="garage" /></span>
          <span class="beispiel-text">
            <span class="beispiel-label">Beispiel: {beispiel.titel}, {beispiel.groesse}</span>
            <strong>ca. {beispiel.von} bis {beispiel.bis} € im Jahr</strong>
            <span class="beispiel-link">Ertrag für Ihren Platz berechnen →</span>
          </span>
        </a>
      </div>
      <FlaecheMelden id="flaeche-melden" />
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Diese Flächen sind gefragt</h2>
        <p class="einleitung">Ein freier Platz auf dem Hof, eine Halle, eine Garage oder ein trockener Keller reichen schon. Gesucht werden Plätze für Wohnmobile, Wohnwagen und Lagergut.</p>
      </div>
      <NachfrageHinweis />
      {link('nachfrage') && <p class="nachfrage-link"><a class="weiter" href={link('nachfrage')!}>Was gefragt ist und was es einbringt</a></p>}
      <Kacheln kacheln={kacheln} />
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap vorteile-raster">
      <div>
        <h2>Ihre Vorteile</h2>
        <Vorteile nur="vermieter" />
      </div>
    </div>
  </section>

  <Ablauf titel="So vermieten Sie Ihre Fläche" schritte={schritte} />

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Warum nicht einfach Kleinanzeigen?</h2>
        <p class="einleitung">Dort finden Sie schnell einen Interessenten. Wer aber monatelang auf Ihrem Grundstück parkt, sollte vertraglich gebunden sein.</p>
      </div>
      <Vergleich zeilen={vergleich} />
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <div class="kopfzeile" id="rechner">
        <h2>Was bringt Ihr Platz im Jahr?</h2>
        <p class="einleitung">Anzahl der Plätze und Miete eintragen, das Ergebnis steht sofort da.{link('verdienstrechner') && <> Was für Ihren Platz üblich ist, zeigt der <a href={link('verdienstrechner')}>Verdienstrechner</a>.</>}</p>
      </div>
      <Ertragsrechner />
    </div>
  </section>
  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Ihre Bedenken, unsere Antworten</h2>
        <p class="einleitung">Was Vermieter am häufigsten fragen, und wie wir es lösen.</p>
      </div>
      <div class="sorgen klapp-liste">
        {sorgen.map((s) => (
          <details class="klapp"><summary>{s.titel}</summary><div class="klapp-inhalt"><p>{s.text}</p></div></details>
        ))}
      </div>
      <p class="zentriert mt"><SmartLink seite="sicherheit" class="weiter">Mehr zur Sicherheit</SmartLink></p>
    </div>
  </section>
  <section class="abschnitt abschnitt-grau">
    <div class="wrap service">
      <span class="symbol-flaeche"><Icon name="kamera" /></span>
      <div>
        <h2>Rundum-Service: Sie schicken 3 Fotos, wir erledigen den Rest</h2>
        <ol class="foto-liste">
          <li>Die Zufahrt von der Straße aus</li>
          <li>Die Fläche selbst, möglichst bei Tageslicht</li>
          <li>Tor, Tür oder Eingang</li>
        </ol>
        <p>Daraus entsteht Ihr Inserat. Wir prüfen es, bevor es online geht.</p>
      </div>
    </div>
  </section>







  <section class="abschnitt abschnitt-dunkel">
    <div class="wrap">
      <div class="hoefe">
        <Bildplatz name="vermieten-hof" ersatz="hof" alt="Blick durch eine Hofeinfahrt auf eine Scheune" />
        <div>
          <h2>Sie haben einen Hof oder eine Scheune?</h2>
          <p>Auf größeren Flächen ist oft Platz für mehrere Wohnwagen oder Wohnmobile. Wir schlagen auch für mehrere Plätze auf einer Fläche passende Mieter vor und stimmen Zufahrt und Zeiten mit Ihnen ab.</p>
          <p><a class="weiter" href={link('vermietenScheune')}>{istLive('vermietenScheune') ? seiten.vermietenScheune.titel : 'Hof oder Scheune anbieten'}</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <Faq seite="vermieten" />
    </div>
  </section>

  <section class="abschnitt zentriert">
    <div class="wrap">
      <h2>Bereit? Bieten Sie Ihren Platz an.</h2>
      <p class="einleitung">In zwei Minuten eingetragen. Fragen? Schreiben Sie uns per WhatsApp oder E-Mail.</p>
      <p class="kontakt-zeile">
        <a class="btn btn-primaer btn-gross" href="#flaeche-melden">Platz anbieten</a>
        <a class="btn btn-rahmen btn-gross" href={whatsappLink} rel="noopener"><Icon name="chat" class="symbol-klein" /> WhatsApp</a>
        <a class="btn btn-rahmen btn-gross" href={emailHref}><Icon name="mail" class="symbol-klein" /> E-Mail</a>
      </p>
    </div>
  </section>
  <FormSkript />
</Basis>
<style>
  /* Hero-Stile (held-*) liegen in global.css, gemeinsam mit /mieten/ */
  .formular-titel { font-size: 1.5rem; letter-spacing: -0.02em; }
  .sorgen { max-width: 50rem; margin-inline: auto; }
  .service { display: grid; gap: 1rem; max-width: 50rem; }
  .service h2 { font-size: clamp(1.6rem, 4vw, 2.25rem); }
  .foto-liste { list-style: none; counter-reset: foto; padding: 0; display: grid; gap: 0.75rem; margin: 1.25rem 0; }
  .foto-liste li { counter-increment: foto; display: flex; align-items: center; gap: 1rem; background: var(--hintergrund); box-shadow: var(--schatten); border-radius: var(--r); padding: 1rem 1.25rem; }
  .foto-liste li::before { content: counter(foto); display: grid; place-items: center; flex: none; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--ueberschrift); color: var(--hintergrund); font-weight: 700; }
  .hoefe { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56rem) { .hoefe { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .hoefe h2 { font-size: clamp(1.6rem, 4vw, 2.25rem); }
  .kontakt-zeile { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2rem; }
  .kontakt-zeile :global(.symbol-klein) { width: 1.3rem; height: 1.3rem; }
</style>
