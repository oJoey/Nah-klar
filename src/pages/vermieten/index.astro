---
import Basis from '../../layouts/Basis.astro';
import Kacheln from '../../components/Kacheln.astro';
import Verdienstrechner from '../../components/Verdienstrechner.astro';
import Ablauf from '../../components/Ablauf.astro';
import Vergleich from '../../components/Vergleich.astro';
import FlaecheMelden from '../../components/FlaecheMelden.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import SmartLink from '../../components/SmartLink.astro';
import Bildplatz from '../../components/Bildplatz.astro';
import FormSkript from '../../components/FormSkript.astro';
import { site, telefonHref, whatsappLink } from '../../config/site';
import { link, seiten, istLive } from '../../config/seiten';
import { zahlung } from '../../config/zahlung';
import { flaechenArten } from '../../data/arten';
import { sichtbareKennzahlen } from '../../lib/kennzahlen';
import { texte } from '../../lib/texte';

const kacheln = flaechenArten.map((a) => ({
  titel: a.titel,
  text: a.nutzen,
  icon: a.icon,
  href: link(a.seite),
  bild: a.bild,
  linkText: istLive(a.seite) ? 'Mehr erfahren' : 'Jetzt anbieten',
}));

const sorgen = [
  { titel: 'Zahlung: Kommt die Miete pünktlich?', text: texte.live
      ? `Die Miete wird am ${zahlung.abbuchungTag}. des Monats automatisch per Lastschrift beim Mieter eingezogen. Am ${zahlung.auszahlungTag}. überweisen wir sie auf Ihr Konto.`
      : texte.zahlungLang },
  { titel: 'Ausfall: Was, wenn der Mieter nicht zahlt?', text: texte.serviceGarantie },
  { titel: 'Schäden: Wer kommt dafür auf?', text: `Jeder Mieter zahlt eine Kaution von einer Monatsmiete, mindestens ${zahlung.kautionMinEuro} €, direkt an Sie. Bei Ein- und Auszug wird der Zustand mit Fotos festgehalten.${site.mieterPruefung ? ' Bei Fahrzeugen muss der Mieter eine gültige Kfz-Versicherung nachweisen.' : ''}` },
  { titel: 'Fremde auf dem Grundstück?', text: site.mieterPruefung
      ? 'Wir prüfen jeden Mieter vorab: Ausweis, bei Fahrzeugen auch Fahrzeugschein und Versicherung. Sie lernen den Mieter bei der Besichtigung kennen und entscheiden selbst, ob Sie vermieten.'
      : 'Sie lernen jeden Interessenten bei der Besichtigung kennen und entscheiden selbst, ob Sie vermieten. Anfragen laufen gebündelt über uns, Ihre Telefonnummer steht nirgends öffentlich.' },
  { titel: 'Steuer: Was muss ich beachten?', text: 'Sie erhalten jedes Jahr eine Übersicht Ihrer Einnahmen. Als Plattform sind wir gesetzlich verpflichtet, Vermieter und Einnahmen jährlich an das Bundeszentralamt für Steuern zu melden (DAC7). Eine Steuerberatung bieten wir nicht an.' },
  { titel: 'Nachbarn: Gibt es Ärger?', text: 'Zufahrtszeiten und Regeln, etwa keine Reparaturen auf dem Hof, legen Sie im Vertrag fest. So wissen alle, woran sie sind.' },
];

// Vergleich aus Sicht der Vermieter. Zeilen mit Schalter erscheinen nur, wenn die Leistung wirklich angeboten wird.
const vergleich = [
  { punkt: 'Jede Fläche von Hand geprüft', anzeige: 'Sie schreiben und prüfen alles selbst', wir: 'Wir prüfen Fotos und Angaben jeder Fläche, bevor wir sie vorschlagen' },
  { punkt: 'Schriftlicher Mustervertrag', anzeige: 'Meist per Handschlag', wir: 'Regeln zu Zufahrt, Kündigung und Zahlung' },
  { punkt: 'Kaution verpflichtend', anzeige: 'Verhandeln Sie selbst', wir: `Eine Monatsmiete, mindestens ${zahlung.kautionMinEuro} €` },
  ...(site.zahlungLive ? [{ punkt: 'Miete per Lastschrift', anzeige: 'Sie laufen dem Geld hinterher', wir: 'Automatisch jeden Monat' }] : []),
  { punkt: 'Persönlicher Ansprechpartner', anzeige: 'Niemand, wenn es Ärger gibt', wir: 'Per Telefon und WhatsApp' },
  { punkt: 'Keine Telefonketten mit Fremden', anzeige: 'Ihre Nummer steht öffentlich', wir: 'Anfragen gebündelt über uns' },
  ...(site.mieterPruefung ? [{ punkt: 'Geprüfte Mieter', anzeige: 'Sie wissen nicht, wer anruft', wir: 'Ausweis, Fahrzeugschein, Versicherung' }] : []),
];

const schritte = [
  { titel: 'Fläche melden', text: 'Drei kurze Schritte im Formular oder ein Anruf.' },
  { titel: 'Prüfung von Hand', text: 'Wir prüfen Fotos und Angaben und melden uns bei Rückfragen.' },
  { titel: 'Passende Mieter', text: 'Wir schlagen Ihnen Interessenten vor. Sie entscheiden, wer einzieht.' },
  { titel: 'Besichtigung und Vertrag', text: 'Sie lernen den Mieter kennen und unterschreiben den Mustervertrag.' },
  { titel: 'Miete erhalten', text: texte.vermieterSchritt4Text },
];

const nachfrage = sichtbareKennzahlen(['suchende', 'suchendeWohnmobil']);
const nachfrageLink = link('nachfrage') ?? link('platzAnbieten');
---
<Basis
  titel="Stellplatz, Garage oder Scheune vermieten in Baden-Württemberg"
  beschreibung="Stellplatz, Garage, Einfahrt, Lagerraum oder Scheune vermieten – mit fairem Nebenverdienst. Für Vermieter immer kostenlos: jede Fläche von Hand geprüft, Mustervertrag, persönlicher Ansprechpartner."
  brotkruemel={[{ name: 'Vermieten', pfad: '/vermieten/' }]}
>
  <section class="held abschnitt-grau">
    <div class="wrap held-raster">
      <div>
        <p class="kicker">Baden-Württemberg</p>
        <h1>Stellplatz, Garage oder Scheune vermieten – mit fairem Nebenverdienst</h1>
        <p class="kostenlos-pille">Für Vermieter immer kostenlos</p>
        <ul class="haken">
          <li>Jede Fläche von Hand geprüft</li>
          <li>Mustervertrag und Kaution</li>
          <li>Persönlicher Ansprechpartner per Telefon und WhatsApp</li>
        </ul>
      </div>
      <FlaecheMelden id="flaeche-melden" />
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Welchen Platz haben Sie frei?</h2>
        <p class="einleitung">Eine Garage, ein freier Platz in der Einfahrt oder ein trockener Keller reichen schon. Gesucht werden Plätze für Autos, Anhänger, Wohnwagen und Lagergut.</p>
      </div>
      <Kacheln kacheln={kacheln} />
    </div>
  </section>

  <Ablauf titel="So vermieten Sie Ihre Fläche" schritte={schritte} />

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Warum nicht einfach Kleinanzeigen?</h2>
        <p class="einleitung">Dort finden Sie schnell einen Interessenten. Wer aber monatelang auf Ihrem Grundstück parkt, sollte vertraglich gebunden sein.</p>
      </div>
      <Vergleich zeilen={vergleich} />
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <div class="kopfzeile"><h2>Was bringt Ihr Platz im Jahr?</h2></div>
      <Verdienstrechner ausfuehrlich />
    </div>
  </section>
  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Ihre Bedenken, unsere Antworten</h2>
        <p class="einleitung">Was Vermieter am häufigsten fragen – und wie wir es lösen.</p>
      </div>
      <div class="sorgen klapp-liste">
        {sorgen.map((s) => (
          <details class="klapp"><summary>{s.titel}</summary><div class="klapp-inhalt"><p>{s.text}</p></div></details>
        ))}
      </div>
      <p class="zentriert mt"><SmartLink seite="sicherheit" class="weiter">Mehr zur Sicherheit</SmartLink></p>
    </div>
  </section>
  <section class="abschnitt abschnitt-grau">
    <div class="wrap service">
      <span class="symbol-flaeche"><Icon name="kamera" /></span>
      <div>
        <h2>Rundum-Service: Sie schicken 3 Fotos, wir erledigen den Rest</h2>
        <ol class="foto-liste">
          <li>Die Zufahrt von der Straße aus</li>
          <li>Die Fläche selbst, möglichst bei Tageslicht</li>
          <li>Tor, Tür oder Eingang</li>
        </ol>
        <p>Daraus erstellen wir die Beschreibung für Mieter und bereiten den Mustervertrag vor. Sie prüfen alles und geben es frei.</p>
      </div>
    </div>
  </section>






  {nachfrage.length > 0 && nachfrageLink && (
    <section class="abschnitt">
      <div class="wrap">
        <h2>Nachfrage in Ihrer Nähe</h2>
        <ul class="haken">
          {nachfrage.map((k) => <li><strong>{k.wert}</strong> {k.text}</li>)}
        </ul>
        <p><a href={nachfrageLink}>{istLive('nachfrage') ? 'Nachfrage nach Orten ansehen' : 'Jetzt Platz anbieten'}</a></p>
      </div>
    </section>
  )}

  <section class="abschnitt abschnitt-dunkel">
    <div class="wrap">
      <div class="hoefe">
        <Bildplatz name="vermieten-hof" ersatz="hof" alt="Blick durch eine Hofeinfahrt auf eine Scheune" />
        <div>
          <h2>Sie haben einen Hof oder eine Scheune?</h2>
          <p>Auf größeren Flächen ist oft Platz für mehrere Autos, Anhänger, Wohnwagen oder Wohnmobile. Wir vermitteln auch mehrere Plätze auf einer Fläche und stimmen Zufahrt und Zeiten mit Ihnen ab.</p>
          <p><a class="weiter" href={link('vermietenScheune')}>{istLive('vermietenScheune') ? seiten.vermietenScheune.titel : 'Hof oder Scheune anbieten'}</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <Faq seite="vermieten" />
    </div>
  </section>

  <section class="abschnitt zentriert">
    <div class="wrap">
      <h2>Bereit? Melden Sie Ihren Platz.</h2>
      <p class="einleitung">Online in zwei Minuten – oder rufen Sie uns an. {site.ansprechpartner}.</p>
      <p><a class="btn btn-primaer btn-gross" href="#flaeche-melden">Fläche melden</a></p>
      <p class="unter-hinweis kostenlos">Für Vermieter immer kostenlos</p>
      <p class="kontakt-zeile">
        <a class="btn btn-rahmen" href={telefonHref}><Icon name="telefon" class="symbol-klein" /> {site.telefonAnzeige}</a>
        <a class="btn btn-rahmen" href={whatsappLink} rel="noopener"><Icon name="chat" class="symbol-klein" /> WhatsApp</a>
      </p>
    </div>
  </section>
  <FormSkript />
</Basis>
<style>
  .held { padding-block: clamp(1.5rem, 6vw, 4.5rem) clamp(3rem, 8vw, 5rem); }
  .held-raster { display: grid; gap: 2rem; }
  @media (min-width: 56rem) { .held-raster { grid-template-columns: 1.1fr 1fr; align-items: start; gap: 4rem; } }
  .held h1 { margin-bottom: 1.25rem; }
  .held .kostenlos-pille { margin-bottom: 1.5rem; }
  .held .haken li { font-size: 1.2rem; }
  .formular-titel { font-size: 1.5rem; letter-spacing: -0.02em; }
  .sorgen { max-width: 50rem; margin-inline: auto; }
  .service { display: grid; gap: 1rem; max-width: 50rem; }
  .service h2 { font-size: clamp(1.6rem, 4vw, 2.25rem); }
  .foto-liste { list-style: none; counter-reset: foto; padding: 0; display: grid; gap: 0.75rem; margin: 1.25rem 0; }
  .foto-liste li { counter-increment: foto; display: flex; align-items: center; gap: 1rem; background: var(--hintergrund); box-shadow: var(--schatten); border-radius: var(--r); padding: 1rem 1.25rem; }
  .foto-liste li::before { content: counter(foto); display: grid; place-items: center; flex: none; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--ueberschrift); color: var(--hintergrund); font-weight: 700; }
  .hoefe { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56rem) { .hoefe { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .hoefe h2 { font-size: clamp(1.6rem, 4vw, 2.25rem); }
  .kontakt-zeile { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2rem; }
  .kontakt-zeile :global(.symbol-klein) { width: 1.3rem; height: 1.3rem; }
</style>
