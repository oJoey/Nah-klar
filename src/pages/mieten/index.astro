---
import { mieterSchritte } from '../../data/ablauf';
import Basis from '../../layouts/Basis.astro';
import SuchauftragFormular from '../../components/SuchauftragFormular.astro';
import FormSkript from '../../components/FormSkript.astro';
import Icon from '../../components/Icon.astro';
import Kacheln from '../../components/Kacheln.astro';
import Schritte from '../../components/Schritte.astro';
import Faq from '../../components/Faq.astro';
import SmartLink from '../../components/SmartLink.astro';
import { link } from '../../config/seiten';
import { zahlung } from '../../config/zahlung';
import { mietArten } from '../../data/arten';
import { texte } from '../../lib/texte';

const kacheln = mietArten.map((a) => ({
  titel: a.titel,
  text: a.nutzen,
  icon: a.icon,
  href: link(a.seite),
  bild: a.bild,
  linkText: link(a.seite)?.startsWith('/suchauftrag/') ? 'Suchauftrag anlegen' : 'Mehr erfahren',
}));

const schritte = mieterSchritte;
---
<Basis
  titel="Stellplatz, Garage oder Lagerraum mieten in Baden-Württemberg"
  beschreibung="Abstellplatz, Garage, Auto-Stellplatz, Platz für Wohnwagen oder Lagerraum privat mieten in Baden-Württemberg. Der Suchauftrag ist kostenlos und unverbindlich: Wir suchen aktiv in Ihrer Nähe."
  brotkruemel={[{ name: 'Mieten', pfad: '/mieten/' }]}
>
  <section class="held-formular abschnitt-grau">
    <div class="held-muster" aria-hidden="true"></div>
    <div class="wrap held-raster">
      <div class="held-text">
        <p class="kicker">Stellplatz, Garage und Lagerraum mieten</p>
        <h1>Sie sagen, was Sie suchen. Wir finden den <span class="markiert">Platz</span>.</h1>
        <p class="einleitung">Kein Durchklicken durch Inserate: Wir fragen gezielt bei Vermietern in Ihrer Nähe nach und melden uns mit passenden Vorschlägen.</p>
        <ul class="held-punkte">
          <li><span class="held-icon"><Icon name="check" /></span>Suchauftrag kostenlos</li>
          <li><span class="held-icon"><Icon name="schild" /></span>Jede Fläche von Hand geprüft</li>
          <li><span class="held-icon"><Icon name="kamera" /></span>Vorschläge mit Fotos, Preis und Ortsteil</li>
        </ul>
        <p class="vermieter-zeile">Sie haben selbst Platz übrig? <a href={link('platzAnbieten')}>Platz anbieten</a>, für Vermieter kostenlos.</p>
      </div>
      <SuchauftragFormular mitWohnmobilZahl={false} />
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile"><h2>Welchen Platz suchen Sie?</h2></div>
      <Kacheln kacheln={kacheln} />
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <div class="kopfzeile"><h2>So kommen Sie zu Ihrem Platz</h2></div>
      <Schritte mieter={schritte} />
    </div>
  </section>



  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <Faq seite="mieten" />
    </div>
  </section>

  <section class="abschnitt zentriert">
    <div class="wrap">
      <h2>Sagen Sie uns, was Sie suchen.</h2>
      <p class="einleitung">Wir melden uns mit passenden Plätzen in Ihrer Nähe.</p>
      <p class="mt"><a class="btn btn-primaer btn-gross" href={link('suchauftrag')}>Suchauftrag anlegen</a></p>
      <p class="unter-hinweis">Der Suchauftrag ist kostenlos und unverbindlich.</p>
    </div>
  </section>
  <FormSkript />
</Basis>
<style>
  .vermieter-zeile { margin-top: 1.5rem; font-size: 1rem; color: var(--text); }
  .kosten { max-width: 50rem; margin: 0 auto; border-top: 1px solid var(--linie); }
  .kosten > div { display: grid; gap: 0.25rem 2rem; padding-block: 1.1rem; border-bottom: 1px solid var(--linie); }
  @media (min-width: 40rem) { .kosten > div { grid-template-columns: 11rem 1fr; } }
  .kosten dt { font-weight: 600; }
  .kosten dd { margin: 0; color: var(--text); }
  .links :global(a + a) { margin-left: 1.5rem; }
</style>
