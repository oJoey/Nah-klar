---
// Kategorieseiten für Mieter. Inhalte in src/data/kategorien.ts.
import Ratgeber from '../../layouts/Ratgeber.astro';
import Icon from '../../components/Icon.astro';
import Schritte from '../../components/Schritte.astro';
import { seiten, link } from '../../config/seiten';
import { kategorien, type Kategorie } from '../../data/kategorien';
import { mieterSchritte } from '../../data/ablauf';

export function getStaticPaths() {
  return kategorien
    .filter((k) => seiten[k.seite].live)
    .map((k) => ({ params: { kategorie: seiten[k.seite].pfad.split('/').filter(Boolean).pop() }, props: { k } }));
}
const { k } = Astro.props as { k: Kategorie };
const suche = `${link('suchauftrag')}?mieter_art=${k.art}`;
const tipps = [
  { titel: 'Zufahrt', icon: 'einfahrt', punkte: k.zufahrt },
  { titel: 'Maße', icon: 'liste', punkte: k.masse },
  { titel: 'Zugang', icon: 'ort', punkte: k.zugang },
] as const;
---
<Ratgeber
  seite={k.seite}
  eltern="mieten"
  typ="WebPage"
  titel={k.titel}
  beschreibung={k.beschreibung}
  kicker={`Mieten · ${seiten[k.seite].titel}`}
  einleitung={k.einleitung}
  verwandt={k.verwandt}
>
  <Fragment slot="h1">{k.h1[0]}<span class="markiert">{k.h1[1]}</span>{k.h1[2]}</Fragment>

  <section class="abschnitt">
    <div class="wrap kat-start">
      <div>
        {k.zahl && <p class="kat-zahl">{k.zahl}</p>}
        <h2>Diese Plätze gibt es</h2>
        <ul class="haken">{k.plaetze.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="karte kat-suche">
        <span class="kat-icon" aria-hidden="true"><Icon name={k.icon} /></span>
        <h2>Noch kein passender Platz frei?</h2>
        <p>Legen Sie einen Suchauftrag an. Wir melden uns, sobald ein passender Platz in Ihrer Nähe frei ist.</p>
        <a class="btn btn-primaer btn-gross btn-voll" href={suche}>Suchauftrag anlegen</a>
        <p class="unter-hinweis">Der Suchauftrag ist kostenlos und unverbindlich.</p>
      </div>
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Darauf sollten Sie achten</h2>
        <p class="einleitung">Bei jedem Vorschlag nennen wir Ihnen, was wir zu Zufahrt, Maßen und Zugang wissen. Diese Fragen sollten Sie vor der Zusage klären.</p>
      </div>
      <ul class="raster tipps">
        {tipps.map((t) => (
          <li class="karte">
            <span class="symbol-flaeche" aria-hidden="true"><Icon name={t.icon} /></span>
            <h3>{t.titel}</h3>
            <ul class="tipp-liste">{t.punkte.map((p) => <li>{p}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile"><h2>So kommen Sie zu Ihrem Platz</h2></div>
      <Schritte mieter={mieterSchritte} />
    </div>
  </section>
</Ratgeber>
<style>
  .kat-start { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 56rem) { .kat-start { grid-template-columns: 1.2fr 1fr; gap: 4rem; } }
  .kat-zahl { margin: 0 0 2rem; padding: 1rem 1.25rem; background: var(--tertiaer); border-radius: var(--r); font-weight: 600; color: var(--ueberschrift); }
  .kat-suche { border: 1.5px solid var(--ueberschrift); box-shadow: 6px 6px 0 var(--ueberschrift); }
  .kat-suche h2 { font-size: 1.4rem; }
  .kat-icon { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: var(--r); background: var(--ueberschrift); margin-bottom: 1rem; }
  .kat-icon :global(.symbol) { color: var(--akzent); }
  .tipps { gap: 1.25rem; }
  .tipp-liste { margin: 0; padding-left: 1.1rem; color: var(--text); }
  .tipp-liste li { margin-bottom: 0.5rem; }
</style>
