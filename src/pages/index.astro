---
// Startseite: richtet sich an Suchende. Vermieter bekommen genau einen Block, der auf /vermieten/ führt.
import Basis from '../layouts/Basis.astro';
import ButtonPaar from '../components/ButtonPaar.astro';
import Suchmaske from '../components/Suchmaske.astro';
import Kacheln from '../components/Kacheln.astro';
import Verdienstrechner from '../components/Verdienstrechner.astro';
import Ablauf from '../components/Ablauf.astro';
import Bewertungen from '../components/Bewertungen.astro';
import WerkzeugeTeaser from '../components/WerkzeugeTeaser.astro';
import Faq from '../components/Faq.astro';
import Bildplatz from '../components/Bildplatz.astro';
import { site, whatsappLink, emailHref } from '../config/site';
import { link } from '../config/seiten';
import { mietArten } from '../data/arten';
import { texte } from '../lib/texte';


const kacheln = mietArten.map((a) => ({
  titel: a.titel,
  text: a.nutzen,
  icon: a.icon,
  href: link(a.seite),
  bild: `kachel-${a.wert}`, // Foto unter src/assets/bilder/kachel-<art>.jpg ablegen, sonst Illustration
  linkText: link(a.seite)?.startsWith('/suchauftrag/') ? 'Suchauftrag anlegen' : 'Mehr erfahren',
}));

const mieterSchritte = [
  { titel: 'Suchauftrag anlegen', text: 'In einer Minute, ohne Konto.' },
  { titel: 'Passende Vorschläge erhalten', text: 'Wir melden uns mit passenden Plätzen, mit Fotos, Preis und Ortsteil.' },
  { titel: 'Besichtigen und unterschreiben', text: 'Sie schauen sich den Platz an und unterschreiben den Mustervertrag.' },
  { titel: 'Kaution zahlen, einziehen', text: texte.live
      ? 'Die Kaution geht direkt an den Vermieter. Die Miete läuft danach automatisch per Lastschrift.'
      : 'Die Kaution geht direkt an den Vermieter. Wie die Miete gezahlt wird, steht im Vertrag.' },
];
---
<Basis
  titel={`Stellplatz, Garage und Lagerraum mieten in Baden-Württemberg | ${site.name}`}
  beschreibung="Stellplatz, Garage, Wohnmobil-Winterplatz oder Lagerraum bei Privatleuten in Baden-Württemberg mieten. Mustervertrag, geregelte Kaution, persönlicher Ansprechpartner."
>
  <section class="held">
    <div class="wrap">
      <div class="held-raster">
        <div>
          <p class="kicker">Stellplatz, Garage und Lagerraum mieten in Baden-Württemberg</p>
          <h1>Platz gesucht? Ihre Nachbarn haben welchen.</h1>
          <p class="einleitung">Für Wohnmobil, Auto, Anhänger oder Lagergut. Bei Privatleuten in Ihrer Nähe, mit Mustervertrag und persönlichem Ansprechpartner.</p>
        </div>
        <Bildplatz name="" alt="" class="held-bild" />
      </div>
      <Suchmaske titel="" />
    </div>
  </section>

  <section class="abschnitt abschnitt-grau" aria-labelledby="arten-titel">
    <div class="wrap">
      <div class="kopfzeile"><h2 id="arten-titel">Was möchten Sie unterstellen?</h2></div>
      <Kacheln kacheln={kacheln} />
      <p class="mt"><a class="weiter" href={link('mieten')}>Alle Infos für Mieter</a></p>
    </div>
  </section>

  <Ablauf titel="So funktioniert's" schritte={mieterSchritte} />

  <section class="abschnitt vermieter-block" aria-labelledby="vermieter-titel">
    <div class="wrap">
      <div class="vermieter-raster">
        <div>
          <p class="kicker">Für Vermieter</p>
          <h2 id="vermieter-titel">Sie haben Platz frei?</h2>
          <p class="einleitung">Eine freie Einfahrt, eine Garage oder eine Scheune bringt im Jahr schnell einige hundert Euro.</p>
          <ul class="haken vermieter-punkte">
            <li>Jede Fläche von Hand geprüft</li>
            <li>Mustervertrag und Kaution</li>
            <li>Persönlicher Ansprechpartner</li>
            <li>Für Sie kostenlos</li>
          </ul>
        </div>
        <Verdienstrechner />
      </div>
      <p class="vermieter-weiter"><a class="btn btn-primaer btn-gross" href={link('vermieten')}>Mehr zum Vermieten</a></p>
    </div>
  </section>

  <Bewertungen />
  <WerkzeugeTeaser />

  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <Faq seite="start"><p>Noch etwas offen? {site.ansprechpartner} per <a href={whatsappLink} rel="noopener">WhatsApp</a> oder <a href={emailHref}>E-Mail</a>.</p></Faq>
    </div>
  </section>

  <section class="abschnitt zentriert">
    <div class="wrap">
      <h2>Platz finden oder Platz anbieten?</h2>
      <p class="einleitung">Beides geht schnell und ist unverbindlich.</p>
      <ButtonPaar mieterZuerst />
    </div>
  </section>
</Basis>
<style>
  .held { padding-block: clamp(1.5rem, 6vw, 4rem) clamp(3rem, 8vw, 5rem); }
  .held-raster { display: grid; gap: 2rem; align-items: center; margin-bottom: clamp(1.5rem, 4vw, 2.5rem); }
  .held .einleitung { margin-top: 1.25rem; margin-bottom: 0; }
  .held :global(.held-bild) { display: none; }
  @media (min-width: 60rem) {
    .held-raster { grid-template-columns: 1.4fr 1fr; gap: 4rem; }
    .held :global(.held-bild) { display: block; aspect-ratio: 5 / 4; }
  }
  /* Vermieter-Block: Tertiärfarbe, Gelb nur am Button */
  .vermieter-block { background: var(--tertiaer); }
  .vermieter-raster { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 64rem) { .vermieter-raster { grid-template-columns: 1fr 1.4fr; gap: 4rem; } }
  .vermieter-punkte { font-weight: 600; margin-top: 1.5rem; }
  .vermieter-weiter { margin: 2rem 0 0; }
  .vermieter-block :global(.rechner) { box-shadow: 6px 6px 0 var(--ueberschrift); }
</style>
