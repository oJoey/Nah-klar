---
// Startseite: ein durchgehender Creme-Hintergrund, Sektionen nur durch Abstand getrennt.
// Bildsprache: schwebende UI-Karten, verbunden durch eine gestrichelte Route (Motiv aus dem Kompass-Logo).
// Genau ein Kartenraster (Kategorien), genau eine dunkle Sektion (Vermieter). Beispielwerte sind als „Beispiel“ gekennzeichnet.
// Keine Kundenstimmen, Logos oder Zähler, bis es echte gibt. Gebühren nur in der FAQ. Fotos: siehe BILDER.md
import Basis from '../layouts/Basis.astro';
import ButtonPaar from '../components/ButtonPaar.astro';
import Zeitstrahl from '../components/Zeitstrahl.astro';
import RegionKarte from '../components/RegionKarte.astro';
import Foto from '../components/Foto.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink, emailHref } from '../config/site';
import { seiten, istLive, link, type SeitenSchluessel } from '../config/seiten';
import { kategorien } from '../data/kategorien';
import { vermieterVorteile } from '../data/vorteile';
import { startorte } from '../data/startorte';
import richtwerte from '../data/richtwerte.json';

const startKategorien = kategorien.filter((k) => k.startseite !== false);
const arten = startKategorien.map((k) => ({ wert: k.art, titel: k.kurz }));
const fotoText: Record<string, string> = {
  'wohnmobil-wohnwagen': 'Wohnmobil in einer offenen Scheune, warmes Abendlicht',
  'anhaenger-boot': 'Boot unter Plane auf einem Trailer an einer Hofeinfahrt',
  'auto-motorrad': 'Auto und Motorrad in einer Garage bei Privatleuten',
  'lagerraum': 'Garage mit gestapelten Kisten und Regal',
};
const such = link('suchauftrag');
const orte = startorte.map((o) => ({ ort: o.ort, href: o.pfad ?? (such ? `${such}?ort=${encodeURIComponent(o.ort)}` : null) }));
const scheune = richtwerte.arten.find((a) => a.wert === 'halle-scheune')?.preise?.['9'] as [number, number] | undefined;

const teaser: { seite: SeitenSchluessel; art: string; text: string; foto: string }[] = [
  { seite: 'diebstahlschutz', art: 'Ratgeber', text: 'Wohnwagen, Wohnmobil oder Anhänger sicher abstellen: Platzwahl, Schlösser und Tracker.', foto: 'Wohnwagen mit Deichselschloss auf einem Hof' },
  { seite: 'einwinterung', art: 'Checkliste', text: 'Schritt für Schritt: So machen Sie Wohnmobil und Wohnwagen winterfest.', foto: '' },
  { seite: 'winterplatzVergleich', art: 'Ratgeber', text: 'Halle, Scheune oder Carport: Welcher Winterplatz passt zu Ihrem Fahrzeug?', foto: '' },
];
const beitraege = teaser.filter((t) => istLive(t.seite));
const [hauptBeitrag, ...weitere] = beitraege;
---
<Basis
  titel={`Stellplatz, Garage und Lagerraum mieten in Baden-Württemberg | ${site.name}`}
  beschreibung="Stellplatz für Wohnmobil, Anhänger oder Auto, Garage oder Lagerraum bei Privatleuten in Baden-Württemberg mieten oder vermieten. Mustervertrag, geprüfte Plätze, persönlicher Ansprechpartner."
>
  <!-- 1. Hero -->
  <section class="held">
    <div class="wrap held-raster">
      <div class="held-text">
        <p class="label">Stellplatz, Garage und Lagerraum in Baden-Württemberg</p>
        <h1>Platz gesucht? Ihre Nachbarn haben welchen.</h1>
        <p class="einleitung">Für Wohnmobil, Anhänger, Auto oder Lagergut. Bei Privatleuten in Ihrer Nähe, mit Mustervertrag und persönlichem Ansprechpartner.</p>
        <form id="suche" class="suchzeile" method="get" action={such}>
          <h2 class="sr-only">Platz suchen</h2>
          <label class="sr-only" for="such-ort">PLZ oder Ort</label>
          <input id="such-ort" name="ort" type="text" autocomplete="postal-code" placeholder="PLZ, Ort" />
          <label class="sr-only" for="such-art">Was möchten Sie unterstellen?</label>
          <select id="such-art" name="mieter_art">
            {arten.map((a) => <option value={a.wert}>{a.titel}</option>)}
          </select>
          <button class="btn btn-primaer" type="submit">Platz finden</button>
        </form>
        <ul class="such-vorteile">
          <li><span class="check" aria-hidden="true"></span>Suchauftrag kostenlos</li>
          <li><span class="check" aria-hidden="true"></span>Mustervertrag inklusive</li>
          <li><span class="check" aria-hidden="true"></span>Persönlicher Ansprechpartner</li>
        </ul>
        <p class="vermieter-hinweis">Sie haben Platz frei? <a href={link('vermieten')}>Platz anbieten →</a></p>
      </div>

      <div class="komposition" aria-hidden="true">
        <Foto name="start-hero" alt="Wohnwagen auf einem Hof vor einer Scheune, warmes Licht" seiten="4 / 5" eager breiten={[480, 720, 960]} sizes="(min-width: 60rem) 38vw, 90vw" class="komposition-foto" />
        <svg class="komposition-route" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M24 17 C 8 30, 6 42, 18 52 M74 62 C 86 70, 92 76, 88 84" /></svg>

        <div class="ui-karte k-naehe">
          <Icon name="ort" />
          <div><strong>Platz in Ihrer Nähe</strong><br />Wir melden uns per WhatsApp oder E-Mail.</div>
        </div>

        <div class="ui-karte k-plan">
          <p class="plan-kopf"><strong>Ihr Suchauftrag</strong><span class="beispiel-label">Beispiel</span></p>
          <p class="plan-stand"><span>2 von 4 Schritten</span></p>
          <div class="plan-balken"><span></span></div>
          <ul class="plan-liste">
            <li><span class="check"></span>Suchauftrag anlegen</li>
            <li><span class="check"></span>Platz wird geprüft</li>
            <li class="naechster"><span class="offen"></span>Vorschlag erhalten</li>
            <li><span class="offen"></span>Mustervertrag unterschreiben</li>
          </ul>
        </div>

        <div class="ui-karte k-geprueft">
          <span class="check"></span>
          <div><strong>Geprüfte Plätze</strong><br />Zufahrt, Maße und Zugang</div>
        </div>
      </div>
    </div>

  </section>

  <!-- 2. Kategorien: das einzige Kartenraster -->
  <section class="sektion" aria-labelledby="arten-titel">
    <div class="wrap">
      <div class="kopf einblenden">
        <p class="label label-leise">Kategorien</p>
        <h2 id="arten-titel">Was möchten Sie unterstellen?</h2>
      </div>
      <ul class="kategorien">
        {startKategorien.map((k, i) => (
          <li class:list={['kategorie einblenden', { breit: i === 0 }]} style={`--verzoegerung:${i * 80}ms`}>
            <Foto name={`kategorie-${k.art}`} alt={fotoText[k.art] ?? k.kurz} seiten={i === 0 ? '16 / 10' : '4 / 3'} breiten={i === 0 ? [640, 960, 1280] : [400, 640, 800]} sizes={i === 0 ? '(min-width: 60rem) 60vw, 100vw' : '(min-width: 60rem) 30vw, 100vw'} />
            <div class="kategorie-text">
              <h3><a href={link(k.seite)}>{k.kurz}</a></h3>
              <p>{k.kachelText}</p>
              <span class="pfeil" aria-hidden="true">Mehr erfahren →</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Ablauf als Zeitstrahl -->
  <section class="sektion" aria-labelledby="ablauf-titel">
    <div class="wrap">
      <div class="kopf einblenden">
        <p class="label label-leise">Ablauf</p>
        <h2 id="ablauf-titel">So funktioniert's</h2>
      </div>
      <div class="einblenden"><Zeitstrahl /></div>
    </div>
  </section>

  <!-- 4. Vermieter: die eine dunkle Sektion -->
  <section class="sektion vermieter" aria-labelledby="vermieter-titel">
    <div class="wrap vermieter-raster">
      <div class="einblenden">
        <p class="label">Für Vermieter</p>
        <h2 id="vermieter-titel">Ungenutzter Platz, der sich bezahlt macht</h2>
        <p class="vermieter-einleitung">Eine Garage, ein Stück Hof oder eine halbe Scheune reichen. Sie bestimmen den Preis und entscheiden, wer einzieht.</p>
        <ul class="vermieter-liste">
          {vermieterVorteile.map((v) => <li><span class="check" aria-hidden="true"></span>{v}</li>)}
        </ul>
        <a class="btn btn-primaer btn-gross" href={link('vermieten')}>Platz anbieten</a>
      </div>
      <div class="vermieter-karten" aria-hidden="true">
        <svg class="vermieter-route" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M30 34 C 28 52, 50 56, 62 66" /></svg>
        <div class="ui-karte v-anfrage einblenden">
          <p class="plan-kopf"><strong>Neue Anfrage für Ihre Scheune</strong><span class="beispiel-label">Beispiel</span></p>
          <p class="v-zeile">Wohnwagen, 6,8 m lang, ab Oktober</p>
          <p class="v-zeile v-ok"><span class="check"></span>Angaben geprüft</p>
        </div>
        {scheune && (
          <div class="ui-karte v-betrag einblenden" style="--verzoegerung:150ms">
            <p class="plan-kopf"><span>Ihr Platz bringt ca.</span><span class="beispiel-label">Beispiel</span></p>
            <p class="v-preis">{scheune[0]} bis {scheune[1]} € <span>im Monat</span></p>
            <p class="v-zeile">Halle oder Scheune, Fahrzeug bis 9 m. Richtwert {richtwerte.region}.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 5. Region mit Karte -->
  <section class="sektion" aria-labelledby="region-titel">
    <div class="wrap region-raster">
      <div class="einblenden">
        <p class="label label-leise">Region</p>
        <h2 id="region-titel">Wo wir starten</h2>
        <p class="region-text">Wir beginnen im Großraum Stuttgart, zuerst im Landkreis Böblingen. Auf Wunsch suchen wir in ganz Baden-Württemberg.</p>
        <p class="region-links">
          {link('regionBoeblingen') && <a class="weiter" href={link('regionBoeblingen')}>Landkreis Böblingen</a>}
          {link('regionen') && <a class="weiter" href={link('regionen')}>Alle Regionen</a>}
        </p>
        <p class="orte-titel">Startorte</p>
        <ul class="orte">
          {orte.map((o) => <li>{o.href ? <a href={o.href} rel={o.href.includes('?') ? 'nofollow' : undefined}>{o.ort}</a> : o.ort}</li>)}
        </ul>
      </div>
      <div class="einblenden" style="--verzoegerung:120ms"><RegionKarte /></div>
    </div>
  </section>

  <!-- 6. Ratgeber -->
  {hauptBeitrag && (
    <section class="sektion" aria-labelledby="ratgeber-titel">
      <div class="wrap">
        <div class="kopf einblenden">
          <p class="label label-leise">Ratgeber</p>
          <h2 id="ratgeber-titel">Ratgeber und Werkzeuge</h2>
        </div>
        <div class="ratgeber-raster">
          <article class="beitrag-gross einblenden">
            <Foto name={`ratgeber-${hauptBeitrag.seite}`} alt={hauptBeitrag.foto} seiten="16 / 9" breiten={[480, 800, 1100]} sizes="(min-width: 60rem) 55vw, 100vw" />
            <p class="beitrag-art">{hauptBeitrag.art}</p>
            <h3><a href={seiten[hauptBeitrag.seite].pfad}>{seiten[hauptBeitrag.seite].titel}</a></h3>
            <p>{hauptBeitrag.text}</p>
          </article>
          <ul class="beitrag-liste einblenden" style="--verzoegerung:120ms">
            {weitere.map((t) => (
              <li>
                <p class="beitrag-art">{t.art}</p>
                <h3><a href={seiten[t.seite].pfad}>{seiten[t.seite].titel}</a></h3>
                <p>{t.text}</p>
              </li>
            ))}
            {link('ratgeber') && <li class="alle"><a class="weiter" href={link('ratgeber')}>Alle Ratgeber</a></li>}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="sektion">
    <div class="wrap einblenden">
      <Faq seite="start" label="Fragen"><p>Noch etwas offen? {site.ansprechpartner} per <a href={whatsappLink} rel="noopener">WhatsApp</a> oder <a href={emailHref}>E-Mail</a>.</p></Faq>
    </div>
  </section>

  <!-- 7. Abschluss: Ende der Route -->
  <section class="sektion abschluss">
    <div class="wrap einblenden">
      <div class="ziel" aria-hidden="true"><span class="ziel-linie"></span><span class="ziel-punkt"></span></div>
      <h2>Platz finden oder Platz anbieten?</h2>
      <p class="abschluss-text">Beides geht schnell und ist unverbindlich.</p>
      <ButtonPaar mieterZuerst />
    </div>
  </section>
</Basis>

<style>
  /* Sektionen nur durch Abstand getrennt, ein Hintergrund */
  .kopf { margin-bottom: clamp(2rem, 4vw, 3rem); max-width: 44rem; }
  .kopf h2 { margin: 0; }

  /* 1. Hero */
  /* Hero: zwei sehr weiche Farbschleier (Pistazie, Pfirsich) für Wärme, Grund bleibt Creme */
  .held { padding-block: clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2rem); background: radial-gradient(ellipse 45% 55% at 85% 30%, var(--sekundaer), transparent 70%), radial-gradient(ellipse 35% 35% at 55% 70%, var(--pfirsich-hell), transparent 70%); }
  .held-raster { display: grid; gap: 3rem; align-items: center; }
  .held h1 { font-size: var(--h1-gross); line-height: 1; letter-spacing: -0.05em; font-weight: 800; margin-bottom: 0; }
  .held .einleitung { margin: 1.5rem 0 0; color: var(--text-leise); max-width: 34rem; }

  .komposition { position: relative; display: grid; gap: 1rem; }
  .komposition :global(.komposition-foto) { width: 100%; aspect-ratio: 16 / 10; }
  .komposition-route { display: none; }
  .k-naehe, .k-geprueft { display: flex; gap: 0.75rem; align-items: flex-start; }
  .k-naehe :global(.symbol) { width: 1.4rem; height: 1.4rem; color: var(--koralle-text); flex: none; margin-top: 0.1rem; }
  .plan-kopf { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin: 0 0 0.5rem; }
  .plan-kopf strong { font-size: 1.1rem; }
  .plan-stand { margin: 0 0 0.45rem; font-size: 0.85rem; color: var(--text-leise); }
  .plan-balken { height: 0.45rem; border-radius: 999px; background: var(--sekundaer); overflow: hidden; }
  .plan-balken span { display: block; width: 50%; height: 100%; border-radius: inherit; background: var(--salbei); }
  .plan-liste { list-style: none; margin: 0.85rem 0 0; padding: 0; }
  .plan-liste li { display: flex; align-items: center; gap: 0.65rem; padding: 0.5rem 0; border-top: 1px solid var(--linie); font-weight: 600; color: var(--ueberschrift); }
  .plan-liste .naechster .offen { border-color: var(--akzent); }

  /* Breite Bildschirme: schwebende Komposition */
  @media (min-width: 60rem) {
    .held-raster { grid-template-columns: 1.05fr 1fr; gap: 3rem; }
    .komposition { display: block; height: 36rem; }
    .komposition :global(.komposition-foto) { position: absolute; right: 0; top: 0; width: 78%; height: 100%; aspect-ratio: auto; }
    .komposition-route { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; z-index: 1; }
    .komposition-route path { fill: none; stroke: var(--route-farbe); stroke-width: var(--route-strich); stroke-dasharray: var(--route-muster); stroke-linecap: round; vector-effect: non-scaling-stroke; }
    .ui-karte { position: absolute; z-index: 2; }
    .k-naehe { left: 0; top: 2.5rem; width: 15.5rem; }
    .k-plan { left: 4%; top: 13.5rem; width: 21rem; }
    .k-geprueft { right: -1rem; bottom: 1.5rem; width: 15rem; }
  }

  /* Suchzeile: kompakt, an den Hero angebunden */
  .suchzeile { display: grid; gap: 0.5rem; margin-top: 2rem; padding: 0.5rem; background: var(--hintergrund); border: 1px solid var(--linie); border-radius: var(--r-karte); box-shadow: var(--schatten-karte); max-width: 40rem; }
  .suchzeile input, .suchzeile select { min-height: 3.25rem; border-color: transparent; background-color: var(--flaeche); font-size: 1.05rem; }
  .suchzeile select { padding-right: 2.25rem; background-position: right 0.85rem center; }
  .suchzeile .btn { min-height: 3.25rem; }
  @media (min-width: 36rem) { .suchzeile { grid-template-columns: minmax(6.5rem, 0.7fr) minmax(14.5rem, 1.5fr) auto; } }
  .vermieter-hinweis { margin: 1.5rem 0 0; font-size: 1rem; color: var(--text); }
  .vermieter-hinweis a { font-weight: 700; }
  .such-vorteile { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.95rem; font-weight: 600; color: var(--text); }
  .such-vorteile li { display: flex; align-items: center; gap: 0.5rem; }

  /* 2. Kategorien */
  .kategorien { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .kategorie { position: relative; display: grid; gap: 1rem; }
  .kategorie h3 { margin: 0 0 0.3rem; font-size: 1.2rem; }
  .kategorie h3 a { color: inherit; text-decoration: none; }
  .kategorie h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--r-karte); }
  .kategorie p { margin: 0 0 0.5rem; color: var(--text-leise); font-size: 1rem; }
  .pfeil { font-weight: 600; color: var(--ueberschrift); font-size: 1rem; }
  .kategorie :global(.foto img) { transition: transform 500ms var(--ease-out); }
  @media (hover: hover) { .kategorie:hover :global(.foto img) { transform: scale(1.03); } .kategorie:hover h3 { text-decoration: underline; text-underline-offset: 0.2em; } }
  .kategorie:has(a:focus-visible) { outline: 3px solid var(--ueberschrift); outline-offset: 4px; border-radius: var(--r-karte); }
  .kategorie h3 a:focus-visible { outline: none; }
  @media (min-width: 40rem) { .kategorien { grid-template-columns: repeat(2, 1fr); } .breit { grid-column: 1 / -1; } }
  @media (min-width: 60rem) {
    .kategorien { grid-template-columns: repeat(3, 1fr); gap: 2rem 1.5rem; }
    .breit { grid-template-columns: 1.6fr 1fr; align-items: center; gap: 2.5rem; }
    .breit h3 { font-size: 1.6rem; }
    .breit p { font-size: 1.1rem; }
  }

  /* 4. Vermieter (dunkel) */
  .vermieter { background: var(--anker); color: var(--auf-dunkel-leise); }
  .vermieter h2 { color: var(--hintergrund); }
  .vermieter .label { color: var(--akzent); }
  .vermieter-raster { display: grid; gap: 3rem; align-items: center; }
  .vermieter-einleitung { font-size: 1.15rem; max-width: 34rem; margin: 1rem 0 1.5rem; }
  .vermieter-liste { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; gap: 0.7rem; }
  .vermieter-liste li { display: flex; gap: 0.7rem; align-items: flex-start; color: var(--hintergrund); font-weight: 600; }
  .vermieter-liste .check { margin-top: 0.15rem; }
  .vermieter-karten { position: relative; display: grid; gap: 1rem; }
  .vermieter-route { display: none; }
  .v-zeile { margin: 0.3rem 0 0; color: var(--text-leise); }
  .v-ok { display: flex; align-items: center; gap: 0.5rem; color: var(--ueberschrift); font-weight: 600; }
  .v-preis { margin: 0.2rem 0 0; font-size: 1.9rem; font-weight: 800; letter-spacing: -0.03em; color: var(--ueberschrift); }
  .v-preis span { font-size: 1rem; font-weight: 500; color: var(--text-leise); }
  @media (min-width: 60rem) {
    .vermieter-raster { grid-template-columns: 1fr 1fr; gap: 4rem; }
    .vermieter-karten { display: block; height: 22rem; }
    .vermieter-route { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .vermieter-route path { fill: none; stroke: rgb(251 248 241 / 0.35); stroke-width: var(--route-strich); stroke-dasharray: var(--route-muster); vector-effect: non-scaling-stroke; }
    .v-anfrage { position: absolute; left: 0; top: 1rem; width: 20rem; }
    .v-betrag { position: absolute; right: 0; bottom: 1rem; width: 21rem; }
  }

  /* 5. Region */
  .region-raster { display: grid; gap: 2.5rem; align-items: center; }
  .region-text { font-size: 1.15rem; color: var(--text); max-width: 32rem; margin-top: 1rem; }
  .region-links { display: flex; flex-wrap: wrap; gap: 0 1.5rem; margin: 0 0 1.75rem; }
  .orte-titel { margin: 0 0 0.4rem; font-size: 0.875rem; font-weight: 700; color: var(--text-leise); }
  .orte { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.2rem 0; font-size: 1rem; }
  .orte li:not(:last-child)::after { content: '·'; margin: 0 0.55rem; color: var(--text-leise); }
  .orte a { color: var(--text); }
  @media (min-width: 60rem) { .region-raster { grid-template-columns: 0.9fr 1.1fr; gap: 4rem; } }

  /* 6. Ratgeber */
  .ratgeber-raster { display: grid; gap: 2.5rem; }
  .beitrag-gross { position: relative; }
  .beitrag-gross h3 { font-size: 1.5rem; margin: 0.3rem 0 0.4rem; }
  .beitrag-art { margin: 1rem 0 0; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-leise); }
  .ratgeber-raster h3 a { color: inherit; text-decoration: none; }
  .ratgeber-raster h3 a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .ratgeber-raster p:not(.beitrag-art) { color: var(--text-leise); margin: 0; }
  .beitrag-liste { list-style: none; margin: 0; padding: 0; }
  .beitrag-liste li { padding: 1.25rem 0; border-top: 1px solid var(--linie); }
  .beitrag-liste li .beitrag-art { margin-top: 0; }
  .beitrag-liste h3 { font-size: 1.2rem; margin: 0.3rem 0; }
  .beitrag-liste .alle { padding-top: 0.75rem; }
  @media (min-width: 60rem) { .ratgeber-raster { grid-template-columns: 1.4fr 1fr; gap: 4rem; align-items: start; } .beitrag-liste li:first-child { border-top: 0; padding-top: 0; } }

  /* 7. Abschluss: Ende der Route */
  .abschluss { text-align: center; padding-top: 2rem; }
  .ziel { display: flex; flex-direction: column; align-items: center; margin-bottom: 2rem; }
  /* Strichel als Verlauf, damit sie sich bewegen lassen (Muster 6px Strich, 7px Lücke wie --route-muster) */
