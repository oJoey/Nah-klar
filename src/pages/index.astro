---
// Startseite: Suche, Kategorien, Ablauf, Vorteile, Nachfrage, Regionen, Ratgeber, FAQ, Abschluss.
// Keine Kundenstimmen, Logos oder Zähler, bis es echte gibt. Gebühren nur in der FAQ.
import Basis from '../layouts/Basis.astro';
import ButtonPaar from '../components/ButtonPaar.astro';
import Suchmaske from '../components/Suchmaske.astro';
import Kacheln from '../components/Kacheln.astro';
import Schritte from '../components/Schritte.astro';
import Vorteile from '../components/Vorteile.astro';
import NachfrageHinweis from '../components/NachfrageHinweis.astro';
import WerkzeugeTeaser from '../components/WerkzeugeTeaser.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import Bildplatz from '../components/Bildplatz.astro';
import { site, whatsappLink, emailHref } from '../config/site';
import { link } from '../config/seiten';
import { kategorien } from '../data/kategorien';
import { mieterSchritte, vermieterSchritte } from '../data/ablauf';
import { vertrauen } from '../data/vorteile';
import { startorte } from '../data/startorte';

const arten = kategorien.map((k) => ({ wert: k.art, titel: k.kurz }));
const kacheln = kategorien.map((k) => ({
  titel: k.kurz,
  text: k.kachelText,
  icon: k.icon,
  href: link(k.seite),
  bild: `kachel-${k.art}`, // Foto unter src/assets/bilder/kachel-<art>.jpg ablegen, sonst Illustration
  linkText: 'Mehr erfahren',
}));
const such = link('suchauftrag');
const orte = startorte.map((o) => ({ ort: o.ort, href: o.pfad ?? (such ? `${such}?ort=${encodeURIComponent(o.ort)}` : null) }));
---
<Basis
  titel={`Stellplatz, Garage und Lagerraum mieten in Baden-Württemberg | ${site.name}`}
  beschreibung="Stellplatz für Wohnmobil, Anhänger oder Auto, Garage oder Lagerraum bei Privatleuten in Baden-Württemberg mieten oder vermieten. Mustervertrag, geprüfte Plätze, persönlicher Ansprechpartner."
>
  <section class="held">
    <div class="wrap">
      <div class="held-raster">
        <div>
          <p class="kicker">Stellplatz, Garage und Lagerraum in Baden-Württemberg</p>
          <h1>Platz gesucht? Ihre <span class="markiert">Nachbarn</span> haben welchen.</h1>
          <p class="einleitung">Für Wohnmobil, Anhänger, Auto oder Lagergut. Bei Privatleuten in Ihrer Nähe, mit Mustervertrag und persönlichem Ansprechpartner.</p>
        </div>
        <Bildplatz name="" alt="" class="held-bild" />
      </div>
      <Suchmaske titel="" arten={arten} mitZeitraum={false} />
      <ul class="vertrauen">
        {vertrauen.map((v) => <li><span class="vertrauen-icon" aria-hidden="true"><Icon name={v.icon} /></span>{v.text}</li>)}
      </ul>
    </div>
  </section>

  <section class="abschnitt abschnitt-grau" aria-labelledby="arten-titel">
    <div class="wrap">
      <div class="kopfzeile"><h2 id="arten-titel">Was möchten Sie unterstellen?</h2></div>
      <Kacheln kacheln={kacheln} />
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="ablauf-titel">
    <div class="wrap">
      <div class="kopfzeile"><h2 id="ablauf-titel">So funktioniert's</h2></div>
      <Schritte mieter={mieterSchritte} vermieter={vermieterSchritte} />
    </div>
  </section>

  <section class="abschnitt abschnitt-grau" aria-labelledby="vorteile-titel">
    <div class="wrap">
      <div class="kopfzeile"><h2 id="vorteile-titel">Ihre Vorteile</h2></div>
      <Vorteile />
    </div>
  </section>

  <section class="abschnitt nachfrage-abschnitt">
    <div class="wrap"><NachfrageHinweis /></div>
  </section>

  <section class="abschnitt abschnitt-grau" aria-labelledby="regionen-titel">
    <div class="wrap">
      <div class="kopfzeile">
        <h2 id="regionen-titel">Wo wir starten</h2>
        <p class="einleitung">Wir beginnen im Großraum Stuttgart und suchen auf Wunsch in ganz Baden-Württemberg.</p>
      </div>
      <ul class="chips orte">
        {orte.map((o) => <li>{o.href ? <a class="chip" href={o.href} rel={o.href.includes('?') ? 'nofollow' : undefined}>{o.ort}</a> : <span class="chip">{o.ort}</span>}</li>)}
      </ul>
      {link('regionen') && <p class="mt"><a class="weiter" href={link('regionen')}>Alle Regionen</a></p>}
    </div>
  </section>

  <WerkzeugeTeaser />

  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <Faq seite="start"><p>Noch etwas offen? {site.ansprechpartner} per <a href={whatsappLink} rel="noopener">WhatsApp</a> oder <a href={emailHref}>E-Mail</a>.</p></Faq>
    </div>
  </section>

  <section class="abschnitt abschnitt-dunkel zentriert abschluss">
    <div class="wrap">
      <h2>Platz finden oder Platz anbieten?</h2>
      <p class="einleitung">Beides geht schnell und ist unverbindlich.</p>
      <ButtonPaar mieterZuerst />
    </div>
  </section>
</Basis>
<style>
  .held { padding-block: clamp(1.5rem, 6vw, 4rem) clamp(3rem, 8vw, 5rem); }
  .held-raster { display: grid; gap: 2rem; align-items: center; margin-bottom: clamp(1.5rem, 4vw, 2.5rem); }
  .held .einleitung { margin-top: 1.25rem; margin-bottom: 0; }
  .held :global(.held-bild) { display: none; }
  @media (min-width: 60rem) {
    .held-raster { grid-template-columns: 1.4fr 1fr; gap: 4rem; }
    .held :global(.held-bild) { display: block; aspect-ratio: 5 / 4; }
  }
  .vertrauen { list-style: none; padding: 0; margin: 1.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; font-weight: 600; color: var(--ueberschrift); }
  .vertrauen li { display: flex; align-items: center; gap: 0.6rem; }
  .vertrauen-icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: var(--r); background: var(--ueberschrift); }
  .vertrauen-icon :global(.symbol) { color: var(--akzent); width: 1.4rem; height: 1.4rem; }
  .nachfrage-abschnitt { padding-block: clamp(2rem, 5vw, 3rem); }
  .nachfrage-abschnitt :global(.nachfrage-hinweis) { margin: 0 auto; }
  .orte { list-style: none; padding: 0; margin: 0; }
  .orte .chip { text-decoration: none; color: var(--ueberschrift); }
  .abschluss :global(.button-paar) { margin-inline: auto; }
  .abschluss :global(.btn-rahmen) { border-color: var(--hintergrund); }
  .abschluss :global(.unter-hinweis) { color: var(--sekundaer); }
</style>
