---
// Startseite: richtet sich an Suchende. Vermieter bekommen genau einen Block, der auf /vermieten/ führt.
import Basis from '../layouts/Basis.astro';
import ButtonPaar from '../components/ButtonPaar.astro';
import Suchmaske from '../components/Suchmaske.astro';
import Icon from '../components/Icon.astro';
import Kacheln from '../components/Kacheln.astro';
import Verdienstrechner from '../components/Verdienstrechner.astro';
import Schritte from '../components/Schritte.astro';
import Bewertungen from '../components/Bewertungen.astro';
import WerkzeugeTeaser from '../components/WerkzeugeTeaser.astro';
import Faq from '../components/Faq.astro';
import Bildplatz from '../components/Bildplatz.astro';
import { site, telefonHref } from '../config/site';
import { link } from '../config/seiten';
import { zahlung } from '../config/zahlung';
import { mietArten } from '../data/arten';
import { texte } from '../lib/texte';
import type { IconName } from '../lib/icons';

// Alles aus Sicht der Mieter. „Geprüfte Mieter“ ist ein Vermieter-Argument und steht auf /vermieten/.
const unterschiede: { icon: IconName; titel: string; text: string }[] = [
  { icon: 'schild', titel: 'Geprüfte Vermieter und Plätze', text: 'Wir kennen jeden Platz von Fotos und sprechen vorab mit dem Vermieter. Sie besichtigen nur, was zu Ihren Angaben passt.' },
  { icon: 'vertrag', titel: 'Mustervertrag mit klaren Regeln', text: 'Zufahrt, Kündigung und Zahlung sind schriftlich geregelt. Kein Handschlag-Deal, bei dem später jeder etwas anderes meint.' },
  { icon: 'euro', titel: 'Kaution geregelt', text: `Eine Monatsmiete, mindestens ${zahlung.kautionMinEuro} €. Zustand mit Fotos bei Ein- und Auszug, Rückzahlung innerhalb von ${zahlung.kautionRueckzahlungWochen} Wochen.` },
  { icon: 'person', titel: 'Fester Ansprechpartner', text: 'Ein Mensch, den Sie per Telefon oder WhatsApp erreichen – auch nach dem Einzug.' },
];

const kacheln = mietArten.map((a) => ({
  titel: a.titel,
  text: a.nutzen,
  icon: a.icon,
  href: link(a.seite),
  linkText: link(a.seite)?.startsWith('/suchauftrag/') ? 'Suchauftrag anlegen' : 'Mehr erfahren',
}));

const mieterSchritte = [
  { titel: 'Suchauftrag anlegen', text: 'In einer Minute: Ort, Art und Zeitraum. Kostenlos und ohne Konto.' },
  { titel: 'Vorschlag erhalten', text: 'Wir melden uns mit passenden Plätzen, mit Fotos, Preis und Ortsteil.' },
  { titel: 'Besichtigen', text: 'Sie schauen sich den Platz an und lernen den Vermieter kennen.' },
  { titel: texte.mieterSchritt4, text: texte.mieterSchritt4Text },
];
---
<Basis
  titel={`Stellplatz, Garage und Lagerraum mieten in Baden-Württemberg | ${site.name}`}
  beschreibung="Stellplatz, Garage, Wohnmobil-Winterplatz oder Lagerraum bei Privatleuten in Baden-Württemberg mieten. Mustervertrag, geregelte Kaution, persönlicher Ansprechpartner."
>
  <section class="held">
    <div class="wrap">
      <div class="held-raster">
        <div>
          <p class="kicker">Stellplatz, Garage und Lagerraum mieten in Baden-Württemberg</p>
          <h1>Platz gesucht? Ihre Nachbarn haben welchen.</h1>
          <p class="einleitung">Für Wohnmobil, Auto, Anhänger oder Kisten – bei Privatleuten in Ihrem Ort, mit Vertrag und festem Ansprechpartner.</p>
        </div>
        <Bildplatz name="" alt="" class="held-bild" />
      </div>
      <Suchmaske titel="" />
    </div>
  </section>

  <section class="abschnitt abschnitt-grau" aria-labelledby="arten-titel">
    <div class="wrap">
      <div class="kopfzeile"><h2 id="arten-titel">Was möchten Sie unterstellen?</h2></div>
      <Kacheln kacheln={kacheln} kompakt ohneFoto />
      <p class="mt"><a class="weiter" href={link('mieten')}>Alle Infos für Mieter</a></p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopfzeile"><h2>So funktioniert's</h2></div>
      <Schritte mieter={mieterSchritte} />
    </div>
  </section>

  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Warum nicht einfach Kleinanzeigen?</h2>
        <p class="einleitung">Dort finden Sie schnell einen Kontakt. Bei einem Platz, den Sie über viele Monate nutzen, kommt es auf mehr an.</p>
      </div>
      <ul class="raster vergleich">
        {unterschiede.map((u) => (
          <li><span class="symbol-flaeche"><Icon name={u.icon} /></span><h3>{u.titel}</h3><p>{u.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="abschnitt abschnitt-kobalt vermieter-block" aria-labelledby="vermieter-titel">
    <div class="wrap vermieter-raster">
      <div>
        <p class="kicker">Für Vermieter</p>
        <h2 id="vermieter-titel">Sie haben Platz frei?</h2>
        <p class="einleitung">Eine freie Einfahrt, eine Garage oder eine Scheune bringt im Jahr schnell einige hundert Euro – ohne viel Aufwand.</p>
        <p class="kostenlos-pille">Für Vermieter immer kostenlos</p>
        <p class="mt"><a class="btn btn-primaer btn-gross" href={link('vermieten')}>Mehr zum Vermieten</a></p>
      </div>
      <Verdienstrechner />
    </div>
  </section>

  <Bewertungen />
  <WerkzeugeTeaser />

  <section class="abschnitt abschnitt-grau">
    <div class="wrap">
      <Faq seite="start"><p>Noch etwas offen? {site.ansprechpartner}: <a href={telefonHref}>{site.telefonAnzeige}</a></p></Faq>
    </div>
  </section>

  <section class="abschnitt zentriert">
    <div class="wrap">
      <h2>Platz finden oder Platz anbieten?</h2>
      <p class="einleitung">Beides geht schnell und ist unverbindlich.</p>
      <ButtonPaar mieterZuerst />
    </div>
  </section>
</Basis>
<style>
  .held { padding-block: clamp(1.5rem, 6vw, 4rem) clamp(3rem, 8vw, 5rem); }
  .held-raster { display: grid; gap: 2rem; align-items: center; margin-bottom: clamp(1.5rem, 4vw, 2.5rem); }
  .held .einleitung { margin-top: 1.25rem; margin-bottom: 0; }
  .held :global(.held-bild) { display: none; }
  @media (min-width: 60rem) {
    .held-raster { grid-template-columns: 1.4fr 1fr; gap: 4rem; }
    .held :global(.held-bild) { display: block; aspect-ratio: 5 / 4; }
  }
  .vergleich { gap: 2rem; }
  .vergleich li { border-top: 2px solid var(--haupt); padding-top: 1.25rem; }
  .vergleich p { color: var(--text-2); margin: 0; }
  @media (min-width: 52rem) { .vergleich { grid-template-columns: repeat(4, 1fr); } }
  .vermieter-raster { display: grid; gap: 2.5rem; align-items: center; }
  .vermieter-raster > div:first-child { max-width: 42rem; }
  .vermieter-block .kostenlos-pille { margin: 0.5rem 0 0; }
  .vermieter-block :global(.rechner) { box-shadow: 6px 6px 0 var(--akzent); }
</style>
