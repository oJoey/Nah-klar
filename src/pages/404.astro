---
import Basis from '../layouts/Basis.astro';
import ButtonPaar from '../components/ButtonPaar.astro';
---
<Basis titel="Seite nicht gefunden" beschreibung="Diese Seite gibt es nicht." noindex>
  <section class="abschnitt">
    <div class="wrap">
      <h1>Diese Seite gibt es leider nicht.</h1>
      <p class="einleitung">Vielleicht hilft Ihnen einer dieser Wege weiter:</p>
      <ButtonPaar />
      <p class="mt"><a href="/">Zur Startseite</a></p>
    </div>
  </section>
</Basis>
